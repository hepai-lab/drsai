{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExternalAgentConfigImportHistoryRecordParams",
  "type": "object",
  "required": [
    "itemTypeResults",
    "providerId"
  ],
  "properties": {
    "itemTypeResults": {
      "description": "Completed results grouped by imported item type.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/ExternalAgentConfigImportHistoryRecordTypeResultParams"
      }
    },
    "providerId": {
      "description": "Opaque provider identifier for the externally completed import.",
      "type": "string"
    }
  },
  "definitions": {
    "ExternalAgentConfigImportHistoryRecordSuccessParams": {
      "type": "object",
      "required": [
        "itemType"
      ],
      "properties": {
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "itemType": {
          "$ref": "#/definitions/ExternalAgentConfigMigrationItemType"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "Original title for an imported session, when available.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ExternalAgentConfigImportHistoryRecordTypeResultParams": {
      "type": "object",
      "required": [
        "failures",
        "itemType",
        "successes"
      ],
      "properties": {
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ExternalAgentConfigImportItemTypeFailure"
          }
        },
        "itemType": {
          "$ref": "#/definitions/ExternalAgentConfigMigrationItemType"
        },
        "successes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ExternalAgentConfigImportHistoryRecordSuccessParams"
          }
        }
      }
    },
    "ExternalAgentConfigImportItemTypeFailure": {
      "type": "object",
      "required": [
        "failureStage",
        "itemType",
        "message"
      ],
      "properties": {
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "errorType": {
          "type": [
            "string",
            "null"
          ]
        },
        "failureStage": {
          "type": "string"
        },
        "itemType": {
          "$ref": "#/definitions/ExternalAgentConfigMigrationItemType"
        },
        "message": {
          "type": "string"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "subErrorType": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ExternalAgentConfigMigrationItemType": {
      "type": "string",
      "enum": [
        "AGENTS_MD",
        "CONFIG",
        "SKILLS",
        "PLUGINS",
        "MCP_SERVER_CONFIG",
        "SUBAGENTS",
        "HOOKS",
        "COMMANDS",
        "MEMORY",
        "SESSIONS"
      ]
    }
  }
}