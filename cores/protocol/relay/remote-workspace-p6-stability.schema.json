{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendrsai.local/contracts/remote-workspace-p6-stability.schema.json",
  "title": "OpenDrSai P6 Two-Device Stability Report",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "environment_id", "source_revision", "build_sha256s", "device_proof_sha256s", "test_variant", "required_duration_seconds", "observed_duration_seconds", "sample_count", "probe_error_count", "duplicate_sequence_count", "missing_sequence_count", "reexecuted_side_effect_count", "relay_latency_p95_ms", "windows_memory_slope_bytes_per_second", "windows_handle_slope_per_second", "transcript_sha256", "boundaries", "faults", "passed"],
  "properties": {
    "schema_version": {"const": "p6-stability/1"},
    "environment_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{3,128}$"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "build_sha256s": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
    "device_proof_sha256s": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
    "test_variant": {"const": "release"},
    "required_duration_seconds": {"type": "integer", "minimum": 3600},
    "observed_duration_seconds": {"type": "number", "minimum": 3600},
    "sample_count": {"type": "integer", "minimum": 2},
    "probe_error_count": {"const": 0}, "duplicate_sequence_count": {"const": 0},
    "missing_sequence_count": {"const": 0}, "reexecuted_side_effect_count": {"const": 0},
    "relay_latency_p95_ms": {"type": "number", "minimum": 0, "exclusiveMaximum": 2000},
    "windows_memory_slope_bytes_per_second": {"type": "number", "exclusiveMaximum": 17477.626666666667},
    "windows_handle_slope_per_second": {"type": "number", "exclusiveMaximum": 0.016666666666666666},
    "transcript_sha256": {"$ref": "#/$defs/digest"},
    "boundaries": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/boundary"}},
    "faults": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/fault"}},
    "passed": {"const": true}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {"type": "string", "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$)).{1,512}$"},
    "proof": {"type": "object", "additionalProperties": false, "required": ["artifact", "bytes", "sha256"], "properties": {"artifact": {"$ref": "#/$defs/artifact"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/digest"}}},
    "boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "device_proof_sha256", "transcript_sha256", "first_sequence", "last_sequence", "sample_count", "proof"],
      "properties": {
        "name": {"enum": ["android_a", "android_b", "windows", "runtime", "relay"]},
        "device_proof_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "transcript_sha256": {"$ref": "#/$defs/digest"},
        "first_sequence": {"type": "integer", "minimum": 0}, "last_sequence": {"type": "integer", "minimum": 1},
        "sample_count": {"type": "integer", "minimum": 2}, "proof": {"$ref": "#/$defs/proof"}
      }
    },
    "fault": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "status", "recovery_seconds", "sequence_preserved", "transcript_preserved", "duplicate_sequence_count", "missing_sequence_count", "reexecuted_side_effect_count", "affected_boundaries", "proof"],
      "properties": {
        "name": {"enum": ["android_background", "android_process_death", "network_change", "runtime_restart", "relay_restart"]},
        "status": {"const": "passed"}, "recovery_seconds": {"type": "number", "minimum": 0, "maximum": 180},
        "sequence_preserved": {"const": true}, "transcript_preserved": {"const": true},
        "duplicate_sequence_count": {"const": 0}, "missing_sequence_count": {"const": 0}, "reexecuted_side_effect_count": {"const": 0},
        "affected_boundaries": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["android_a", "android_b", "windows", "runtime", "relay"]}},
        "proof": {"$ref": "#/$defs/proof"}
      }
    }
  }
}
