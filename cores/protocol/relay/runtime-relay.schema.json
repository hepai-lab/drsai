    "subject_summary": {
      "type": "string",
      "pattern": "^sub_[0-9a-f]{12}$",
      "description": "Irreversible subject summary. Raw OIDC subject is never returned."
    },
    "device_id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$",
      "description": "Stable opaque Android installation identity."
    },
    "device_summary": {
      "type": "string",
      "pattern": "^dev_[0-9a-f]{12}$",
      "description": "Irreversible device summary returned to the Runtime."
    },
    "device_public_key": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "Raw 32-byte Ed25519 public key encoded as unpadded Base64URL."
    },
    "push_registration_request": {
      "type": "object",
      "required": [
        "provider",
        "token",
        "generation"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_-]+$"
        },
        "token": {
          "type": "string",
          "minLength": 32,
          "maxLength": 4096,
          "pattern": ".*\\S.*",
          "writeOnly": true,
          "description": "Provider token accepted only over device-bound HTTPS and stored as a one-way digest."
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
