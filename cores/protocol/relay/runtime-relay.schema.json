    "runtime_http_request_frame": {
      "type": "object",
      "required": [
        "type",
        "request_id",
        "correlation_id",
        "method",
        "path",
        "body"
      ],
      "properties": {
        "type": {
          "const": "request"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PATCH",
            "PUT",
            "DELETE"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/v1/"
        },
        "body": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "runtime_http_response_frame": {
      "type": "object",
      "required": [
        "type",
        "request_id",
        "status"
      ],
      "properties": {
        "type": {
          "const": "response"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "body": {},
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "minimum": 400
              }
            }
          },
          "then": {
            "required": [
              "error"
            ],
            "not": {
              "required": [
                "body"
              ]
            }
          },
          "else": {
            "required": [
              "body"
            ],
            "not": {
              "required": [
                "error"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
