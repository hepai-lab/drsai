  "$defs": {
    "resource_lifecycle": {
      "type": "string",
      "enum": [
        "active",
        "archived",
        "removed"
      ]
    },
    "workspace": {
      "type": "object",
      "required": [
        "runtime_id",
        "workspace_id",
        "display_name",
        "lifecycle",
        "revision",
        "updated_at"
      ],
      "properties": {
        "runtime_id": {
          "type": "string",
          "minLength": 1
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle": {
          "$ref": "#/$defs/resource_lifecycle"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "required": [
        "runtime_id",
        "workspace_id",
        "session_id",
        "title",
        "lifecycle",
        "updated_at"
      ],
      "properties": {
        "runtime_id": {
          "type": "string",
          "minLength": 1
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "lifecycle": {
          "$ref": "#/$defs/resource_lifecycle"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "agent_definition_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "agent_definition_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "backend_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_run_status": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "conversation_item": {
      "type": "object",
      "required": [
        "item_id",
        "sequence",
        "kind",
        "timestamp",
        "payload"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "session_conversation_item": {
      "type": "object",
      "required": [
        "item_id",
        "session_id",
        "run_id",
        "kind",
        "role",
        "revision",
        "session_sequence",
        "source_client",
        "source_message_id",
        "created_at",
        "updated_at",
        "payload"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "message",
            "reasoning",
            "tool",
            "file_change",
            "approval",
            "artifact",
            "error"
          ]
        },
        "role": {
          "enum": [
            "user",
            "assistant",
            "system",
            "tool",
            null
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "session_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "source_client": {
          "enum": [
            "windows",
            "android",
            "runtime"
          ]
        },
        "source_message_id": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "conversation_snapshot": {
      "type": "object",
      "required": [
        "session_id",
        "snapshot_sequence",
        "items",
        "next_cursor"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/session_conversation_item"
          }
        },
        "next_cursor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "control_request": {
      "type": "object",
      "required": [
        "request_id",
        "correlation_id"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 8
        }
      },
      "additionalProperties": false
    },
    "session_create_request": {
      "type": "object",
      "required": [
        "request_id",
        "correlation_id",
        "idempotency_key",
        "title",
        "agent_definition_id",
        "agent_definition_version"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 8
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "agent_definition_id": {
          "type": "string",
          "minLength": 1
        },
        "agent_definition_version": {
          "type": "string",
          "minLength": 1,
          "not": {
            "const": "latest"
          }
        }
      },
      "additionalProperties": false
    },
    "session_update_request": {
      "type": "object",
      "required": [
        "request_id",
        "correlation_id"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "lifecycle": {
          "$ref": "#/$defs/resource_lifecycle"
        }
      },
      "anyOf": [
        {
          "required": [
            "title"
          ]
        },
        {
          "required": [
            "lifecycle"
          ]
        }
      ],
      "additionalProperties": false
    },
    "run_create_request": {
      "type": "object",
      "required": [
        "request_id",
        "correlation_id",
        "idempotency_key",
        "message"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 8
        },
        "message": {
          "type": "string"
        },
        "source_message_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "attachment_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 100,
          "default": []
        },
        "retry_of": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "approval_decision_request": {
      "type": "object",
      "required": [
        "request_id",
        "correlation_id",
        "decision"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_key": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 8
        },
        "decision": {
          "type": "string",
          "enum": [
            "approve",
            "deny",
            "cancel"
          ]
        }
      },
      "additionalProperties": false
    },
    "latency_observation_request": {
      "type": "object",
      "required": [
        "client_receive_at_ms",
        "render_at_ms"
      ],
      "properties": {
        "client_receive_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "render_at_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": [
        "runtime_id",
        "workspace_id",
        "session_id",
        "run_id",
        "backend_id",
        "status",
        "correlation_id",
        "created_at",
        "message",
        "attachment_refs"
      ],
      "properties": {
        "runtime_id": {
          "type": "string",
          "minLength": 1
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "backend_id": {
          "type": "string",
          "minLength": 1
