{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendrsai.local/contracts/remote-workspace-p6-product-acceptance.schema.json",
  "title": "OpenDrSai Mobile Remote Workspace P6 Product Acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "environment_id", "source_revision", "build_sha256s", "device_proof_sha256s", "test_variant", "app_package", "desktop_product", "relay_service", "journeys", "accessibility_checks", "accessibility_violations", "open_p0_count", "open_p1_count", "raw_sensitive_content_exported", "human_confirmed", "passed"],
  "properties": {
    "schema_version": {"const": "p6-product-acceptance/1"},
    "environment_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{3,128}$"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "build_sha256s": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
    "device_proof_sha256s": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
    "test_variant": {"const": "release"},
    "app_package": {"const": "ai.drsai.remote"},
    "desktop_product": {"const": "OpenDrSaiDesktop"},
    "relay_service": {"const": "opendrsai-runtime-relay"},
    "journeys": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/journey"}},
    "accessibility_checks": {
      "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true,
      "items": {"enum": ["talkback_order", "dynamic_text_200_percent", "touch_target_48dp", "keyboard_focus", "actionable_error_state"]}
    },
    "accessibility_violations": {"const": 0},
    "open_p0_count": {"const": 0}, "open_p1_count": {"const": 0},
    "raw_sensitive_content_exported": {"const": false},
    "human_confirmed": {"const": true}, "passed": {"const": true}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {"type": "string", "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$)).{1,512}$"},
    "proof": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact", "bytes", "sha256"],
      "properties": {"artifact": {"$ref": "#/$defs/artifact"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/digest"}}
    },
    "journey": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "status", "started_at", "completed_at", "elapsed_ms", "threshold_ms", "device_proof_sha256s", "windows_observed", "android_observed", "relay_observed", "sequence_start", "sequence_end", "invariants", "proof_artifacts"],
      "properties": {
        "name": {"enum": ["pair_by_qr", "browse_host_workspace_catalog", "browse_session_catalog", "bidirectional_message", "model_stream_and_tool_activity", "approval_decision", "cancel_and_retry", "offline_network_recovery", "runtime_relay_restart_recovery", "targeted_device_revoke"]},
        "status": {"const": "passed"},
        "started_at": {"type": "string", "format": "date-time"}, "completed_at": {"type": "string", "format": "date-time"},
        "elapsed_ms": {"type": "integer", "minimum": 0}, "threshold_ms": {"type": "integer", "minimum": 1},
        "device_proof_sha256s": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
        "windows_observed": {"const": true}, "android_observed": {"const": true}, "relay_observed": {"const": true},
        "sequence_start": {"type": ["integer", "null"], "minimum": 0}, "sequence_end": {"type": ["integer", "null"], "minimum": 0},
        "invariants": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,127}$"}},
        "proof_artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/proof"}}
      }
    }
  }
}
