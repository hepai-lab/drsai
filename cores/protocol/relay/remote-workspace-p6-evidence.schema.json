{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendrsai.local/contracts/remote-workspace-p6-evidence.schema.json",
  "title": "OpenDrSai Mobile Remote Workspace P6 Evidence Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_revision", "environment", "builds", "devices", "endpoint_reports", "features", "evidence", "p5_transition", "completion_inherited", "passed"],
  "properties": {
    "schema_version": {"const": "p6-evidence-ledger/1"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["environment_id", "relay_origin", "runtime_release", "relay_revision", "relay_contract_sha256", "oaep_schema_sha256"],
      "properties": {
        "environment_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{3,128}$"},
        "relay_origin": {"type": "string", "pattern": "^https://[^/?#]+$"},
        "runtime_release": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "relay_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "relay_contract_sha256": {"$ref": "#/$defs/digest"},
        "oaep_schema_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "builds": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/build"}},
    "devices": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/device"}},
    "endpoint_reports": {
      "type": "object", "additionalProperties": false, "required": ["windows", "relay"],
      "properties": {"windows": {"$ref": "#/$defs/report_ref"}, "relay": {"$ref": "#/$defs/report_ref"}}
    },
    "features": {"type": "array", "minItems": 40, "maxItems": 40, "uniqueItems": true, "items": {"$ref": "#/$defs/feature"}},
    "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}},
    "p5_transition": {"$ref": "#/$defs/report_ref"},
    "completion_inherited": {"const": false},
    "passed": {"const": true}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {"type": "string", "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$)).{1,512}$"},
    "build": {
      "type": "object", "additionalProperties": false,
      "required": ["build_id", "platform", "type", "version", "revision", "identity", "artifact", "bytes", "sha256"],
      "properties": {
        "build_id": {"enum": ["android", "windows", "relay"]},
        "platform": {"enum": ["android", "windows", "relay"]},
        "type": {"const": "release"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "identity": {"enum": ["ai.drsai.remote", "OpenDrSaiDesktop", "opendrsai-runtime-relay"]},
        "artifact": {"$ref": "#/$defs/artifact"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "report_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact", "bytes", "sha256"],
      "properties": {"artifact": {"$ref": "#/$defs/artifact"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/digest"}}
    },
    "device": {
      "type": "object", "additionalProperties": false,
      "required": ["physical", "emulator", "device_proof_sha256", "android_build_sha256", "report"],
      "properties": {
        "physical": {"const": true}, "emulator": {"const": false},
        "device_proof_sha256": {"$ref": "#/$defs/digest"}, "android_build_sha256": {"$ref": "#/$defs/digest"},
        "report": {"$ref": "#/$defs/report_ref"}
      }
    },
    "feature": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^P6-M0[1-8]-F0[1-5]$"}, "status": {"const": "passed"},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^ev_[A-Za-z0-9._-]{3,128}$"}}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "kind", "environment_id", "feature_ids", "build_sha256s", "physical_device_proof_sha256s", "report"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^ev_[A-Za-z0-9._-]{3,128}$"},
        "kind": {"enum": ["local", "production", "physical", "release", "human"]},
        "environment_id": {"type": "string", "minLength": 3, "maxLength": 128},
        "feature_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^P6-M0[1-8]-F0[1-5]$"}},
        "build_sha256s": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
        "physical_device_proof_sha256s": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
        "report": {"$ref": "#/$defs/report_ref"}
      }
    }
  }
}
