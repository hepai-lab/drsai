{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendrsai.local/schemas/remote-workspace-p5-evidence.schema.json",
  "title": "OpenDrSai Mobile Remote Workspace P5 Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "environment", "build", "contract_report", "devices", "features", "evidence", "secret_scan", "stability_report", "legacy_removal", "experience_report"],
  "properties": {
    "schema_version": {"const": "p5/1"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_id", "relay_url", "runtime_version", "schema_hash", "platform_contract_sha256"],
      "properties": {
        "environment_id": {"type": "string", "minLength": 1},
        "relay_url": {"type": "string", "pattern": "^https://"},
        "runtime_version": {"type": "string", "minLength": 1},
        "schema_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "platform_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "artifact", "bytes", "sha256"],
      "properties": {
        "type": {"const": "release"},
        "version": {"type": "string", "minLength": 1},
        "artifact": {"$ref": "#/$defs/artifactPath"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "contract_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "environment_id", "relay_url", "platform_contract_sha256", "artifact", "artifact_bytes", "artifact_sha256", "openapi_artifact", "openapi_sha256", "openapi_bytes", "verified_endpoints", "passed"],
      "properties": {
        "schema_version": {"const": "p5-contract-evidence/1"},
        "environment_id": {"type": "string", "minLength": 1},
        "relay_url": {"type": "string", "pattern": "^https://"},
        "platform_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifact": {"$ref": "#/$defs/artifactPath"},
        "artifact_bytes": {"type": "integer", "minimum": 1},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "openapi_artifact": {"$ref": "#/$defs/artifactPath"},
        "openapi_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "openapi_bytes": {"type": "integer", "minimum": 1},
        "verified_endpoints": {
          "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true,
          "items": {"enum": [
            "/runtimes/{runtime_id}/workspaces/{workspace_id}/session-catalog-events/stream",
            "/metrics/protocol-usage",
            "/metrics/protocol-usage/deletion-decision",
            "/associations/{runtime_id}/push-registration#PUT",
            "/associations/{runtime_id}/push-registration#DELETE"
          ]}
        },
        "passed": {"const": true}
      }
    },
    "devices": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["physical", "emulator", "proof_artifact", "proof_bytes", "proof_sha256"],
        "properties": {
          "physical": {"const": true}, "emulator": {"const": false},
          "proof_artifact": {"$ref": "#/$defs/artifactPath"},
          "proof_bytes": {"type": "integer", "minimum": 1},
          "proof_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "features": {
      "type": "array", "minItems": 48, "maxItems": 48,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "evidence_sha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^P5-M0[1-8]-F0[1-6]$"},
          "status": {"const": "passed"},
          "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "evidence": {
      "type": "array", "minItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["category", "artifact", "bytes", "sha256", "environment_id", "feature_ids"],
        "properties": {
          "category": {"enum": ["contract", "android", "desktop", "runtime", "relay", "security", "stability", "accessibility"]},
          "artifact": {"$ref": "#/$defs/artifactPath"},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "environment_id": {"type": "string", "minLength": 1},
          "feature_ids": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^P5-M0[1-8]-F0[1-6]$"}
          }
        }
      }
    },
    "stability_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "environment_id", "artifact", "artifact_bytes", "artifact_sha256", "passed", "required_duration_seconds", "observed_duration_seconds", "probe_error_count", "duplicate_sequence_count", "missing_sequence_count", "reexecuted_side_effect_count", "relay_latency_p95_ms", "windows_memory_slope_bytes_per_second", "windows_handle_slope_per_second", "transcript_hashes", "faults"],
      "properties": {
        "schema_version": {"const": "p5-stability/1"},
        "environment_id": {"type": "string", "minLength": 1},
        "artifact": {"$ref": "#/$defs/artifactPath"},
        "artifact_bytes": {"type": "integer", "minimum": 1},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "passed": {"const": true},
        "required_duration_seconds": {"type": "integer", "minimum": 3600},
        "observed_duration_seconds": {"type": "number", "minimum": 3600},
        "probe_error_count": {"const": 0},
        "duplicate_sequence_count": {"const": 0},
        "missing_sequence_count": {"const": 0},
        "reexecuted_side_effect_count": {"const": 0},
        "relay_latency_p95_ms": {"type": "number", "minimum": 0, "exclusiveMaximum": 2000},
        "windows_memory_slope_bytes_per_second": {"type": "number", "exclusiveMaximum": 17476.266666666666},
        "windows_handle_slope_per_second": {"type": "number", "exclusiveMaximum": 0.016666666666666666},
        "transcript_hashes": {
          "type": "object", "additionalProperties": false,
          "required": ["android", "desktop", "runtime"],
          "properties": {
            "android": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "desktop": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "runtime": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "faults": {
          "type": "array", "minItems": 5, "maxItems": 5,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "status", "sequence_preserved", "transcript_preserved", "duplicate_sequence_count", "missing_sequence_count", "reexecuted_side_effect_count"],
            "properties": {
              "name": {"enum": ["android_background", "android_process_death", "network_change", "runtime_restart", "relay_restart"]},
              "status": {"const": "passed"},
              "sequence_preserved": {"const": true},
              "transcript_preserved": {"const": true},
              "duplicate_sequence_count": {"const": 0},
              "missing_sequence_count": {"const": 0},
              "reexecuted_side_effect_count": {"const": 0}
            }
          }
        }
      }
    },
    "legacy_removal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "environment_id", "passed", "decision", "decision_artifact",
        "decision_bytes", "decision_sha256", "rollback_artifact", "rollback_bytes",
        "rollback_sha256", "migration", "migration_artifact", "migration_bytes",
        "migration_sha256"
      ],
      "properties": {
        "schema_version": {"const": "p5-legacy-removal/1"},
        "environment_id": {"type": "string", "minLength": 1},
        "passed": {"const": true},
        "decision": {"type": "object"},
        "decision_artifact": {"$ref": "#/$defs/artifactPath"},
        "decision_bytes": {"type": "integer", "minimum": 1},
        "decision_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "rollback_artifact": {"$ref": "#/$defs/artifactPath"},
        "rollback_bytes": {"type": "integer", "minimum": 1},
        "rollback_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "migration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version", "database_migration_verified", "migration_transcript_before_sha256",
            "migration_transcript_after_sha256", "rollback_artifact_sha256"
          ],
          "properties": {
            "schema_version": {"const": "p5-legacy-migration/1"},
            "database_migration_verified": {"const": true},
            "migration_transcript_before_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "migration_transcript_after_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "rollback_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "migration_artifact": {"$ref": "#/$defs/artifactPath"},
        "migration_bytes": {"type": "integer", "minimum": 1},
        "migration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "experience_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "environment_id", "artifact", "artifact_bytes", "artifact_sha256",
        "passed", "device_proof_sha256s", "checks", "manual_scenarios",
        "accessibility_violations", "raw_sensitive_content_exported"
      ],
      "properties": {
        "schema_version": {"const": "p5-experience/1"},
        "environment_id": {"type": "string", "minLength": 1},
        "artifact": {"$ref": "#/$defs/artifactPath"},
        "artifact_bytes": {"type": "integer", "minimum": 1},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "passed": {"const": true},
        "device_proof_sha256s": {
          "type": "array", "minItems": 2, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "checks": {
          "type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true,
          "items": {"enum": [
            "talkback_navigation", "touch_target_48dp", "dynamic_text_200_percent", "contrast",
            "connection_state_action", "approval_risk_announcement", "notification_deep_link",
            "offline_stale_semantics"
          ]}
        },
        "manual_scenarios": {
          "type": "array", "minItems": 8, "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "status"],
            "properties": {
              "name": {"enum": [
                "pair_by_qr", "browse_catalog", "open_session", "send_message",
                "approval_decision", "cancel_and_retry", "revoke_device", "recover_after_restart"
              ]},
              "status": {"const": "passed"}
            }
          }
        },
        "accessibility_violations": {"const": 0},
        "raw_sensitive_content_exported": {"const": false}
      }
    },
    "secret_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "profile", "environment_id", "canary_run_id", "artifact", "artifact_bytes", "artifact_sha256", "passed", "matches", "raw_artifacts_crossed_trust_boundary", "sources", "boundary_reports"],
      "properties": {
        "schema_version": {"const": "p5-secret/1"},
        "profile": {"const": "mobile-remote-workspace-p5"},
        "environment_id": {"type": "string", "minLength": 1},
        "canary_run_id": {"type": "string", "minLength": 1},
        "artifact": {"$ref": "#/$defs/artifactPath"},
        "artifact_bytes": {"type": "integer", "minimum": 1},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "passed": {"const": true},
        "matches": {"const": 0},
        "raw_artifacts_crossed_trust_boundary": {"const": false},
        "sources": {
          "type": "array", "minItems": 11, "maxItems": 11,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "boundary", "status", "bytes_scanned", "files_scanned"],
            "properties": {
              "name": {"enum": ["android_apk", "android_logs", "android_room", "android_backup", "windows_database", "windows_dpapi", "windows_logs", "windows_dump", "relay_postgres", "relay_redis", "relay_logs"]},
              "boundary": {"enum": ["android", "windows", "relay"]},
              "status": {"const": "clean"},
              "bytes_scanned": {"type": "integer", "minimum": 1},
              "files_scanned": {"type": "integer", "minimum": 1}
            }
          }
        },
        "boundary_reports": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["boundary", "report_sha256", "source_count"],
            "properties": {
              "boundary": {"enum": ["android", "windows", "relay"]},
              "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "source_count": {"type": "integer", "minimum": 3, "maximum": 4},
              "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "allOf": [{
              "if": {"properties": {"boundary": {"const": "android"}}},
              "then": {"required": ["artifact_sha256"]},
              "else": {"not": {"required": ["artifact_sha256"]}}
            }]
          }
        }
      }
    }
  },
  "$defs": {
    "artifactPath": {
      "type": "string", "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    }
  }
}
