{
  "name": "@drsai/ui-tui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "DrSai TUI — React/Ink frontend over JSON-RPC gateway",
  "scripts": {
    "dev": "tsx src/entry.tsx",
