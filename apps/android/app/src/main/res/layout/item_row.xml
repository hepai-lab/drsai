<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginVertical="4dp"
    android:background="?attr/colorSurface">
    <TextView android:id="@+id/primary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="16sp" android:textStyle="bold" android:textColor="@color/ink"/>
    <TextView android:id="@+id/secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="@color/moss"/>
</LinearLayout>
