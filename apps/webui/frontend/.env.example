# 后端 API 地址。
# 默认【注释掉】：DEV 下浏览器走同源 /api（Gatsby develop 把 /api 代理到后端）。
#   代理目标由 GATSBY_DEV_API_PORT 决定（默认 8086，见 gatsby-node.ts）。
# 仅当后端不在「访问前端所用主机的 8086 端口」时，才取消注释并显式指定：
# GATSBY_API_URL="http://localhost:8086/api"
#
# 后端端口可覆盖（默认 8086）：
# GATSBY_DEV_API_PORT="8086"
#
# Gatsby 编译并行核数（gatsby develop / build 用，默认 16）
GATSBY_CPU_COUNT=16

# 是否启用本地账号注册功能（默认 false）
# 与 GATSBY_ALLOW_REGISTER 任一为 true 即显示注册入口（Gatsby 需 GATSBY_ 前缀）
GATSBY_ENABLE_LOCAL_REGISTRATION=false
GATSBY_ALLOW_REGISTER=false
# build:dev 未在脚本里写死上述变量；需要注册入口时可：
# - 构建前 export GATSBY_ALLOW_REGISTER=true，或
# - 复制本文件为 .env.development 并设为 true（gatsby build 在 NODE_ENV=development 时会加载）

# 欢迎页客户端下载地址。未设置时会跳转到 GitHub Releases 最新版本页面。
# GATSBY_WINDOWS_DOWNLOAD_URL="https://download-opendrsai.ihep.ac.cn/releases/v1.5.2/windows/OpenDrSai-Windows-Installer-x64.msi"
# GATSBY_ANDROID_DOWNLOAD_URL="https://download-opendrsai.ihep.ac.cn/releases/v1.5.1/android/OpenDrSai-Android-v1.5.1.apk"
