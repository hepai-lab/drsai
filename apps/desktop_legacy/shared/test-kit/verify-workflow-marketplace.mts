const root = await mkdtemp(join(tmpdir(), "drsai-workflows-"));
try {
  process.env.DRSAI_HOME = root;
  const [workflowViewSource, mockApiSource] = await Promise.all([
    readFile(join(process.cwd(), "../shared/renderer/src/components/SkillSquareView.tsx"), "utf8"),
