  await login("owner", "owner@example.test");
  const secretPath = join(workspace, "sensitive.txt"); await writeFile(secretPath, "Bearer abcdefghijklmnop\ncontact person@example.test\n"); const secretTask = await tasks.enqueueBackgroundTask({ kind: "agent_run", source: "agent", title: "Sensitive analysis", status: "completed", workspacePath: workspace, idempotencyKey: "share-source:sensitive", deliverySummary: { summary: "Sensitive", artifacts: [{ id: "artifact-secret", label: "Sensitive report", path: secretPath, kind: "report" }] } });
  const sensitive = await shares.inspectShare({ sourceTaskId: secretTask.id, scope: "result_only", artifactId: "artifact-secret" }); assert.equal(sensitive.requiresResolution, true); assert(sensitive.findings.some((item) => item.kind === "bearer_token") && sensitive.findings.some((item) => item.kind === "email"));
  await assert.rejects(() => shares.createShare({ sourceTaskId: secretTask.id, scope: "result_only", artifactId: "artifact-secret", recipientAccount: "recipient@example.test" }), /review/i);
  await assert.rejects(() => shares.createShare({ sourceTaskId: secretTask.id, scope: "result_only", artifactId: "artifact-secret", recipientAccount: "recipient@example.test", sensitiveResolutions: [{ findingId: sensitive.findings[0].id, action: "redact" }, { findingId: "sensitive:00000000000000000000", action: "remove" }] }), /match|review/i);
  const secretShare = await shares.createShare({ sourceTaskId: secretTask.id, scope: "result_only", artifactId: "artifact-secret", recipientAccount: "recipient@example.test", sensitiveResolutions: sensitive.findings.map((item) => ({ findingId: item.id, action: item.kind === "email" ? "remove" as const : "redact" as const })) }); assert.equal(secretShare.sensitiveReview?.highRiskSecretsDirectlyShared, 0);
  await writeFile(secretPath, "Bearer zyxwvutsrqponmlk\ncontact next@example.test\n"); const secretVersion = await shares.inspectShareVersion({ shareId: secretShare.id }); await assert.rejects(() => shares.publishShareVersion({ shareId: secretShare.id, expectedVersion: 1, sourceFingerprints: secretVersion.sourceFingerprints }), /review/i); const currentSensitive = await shares.inspectShare({ sourceTaskId: secretTask.id, scope: "result_only", artifactId: "artifact-secret" }); const secretPublished = await shares.publishShareVersion({ shareId: secretShare.id, expectedVersion: 1, sourceFingerprints: secretVersion.sourceFingerprints, sensitiveResolutions: currentSensitive.findings.map((item) => ({ findingId: item.id, action: "redact" as const })) }); assert.equal(secretPublished.currentVersion, 2); assert.equal(secretPublished.manifest.sensitiveReview?.highRiskSecretsDirectlyShared, 0); const secretAudit = await shares.listShareAudit({ shareId: secretShare.id }); assert(secretAudit.some((entry) => entry.action === "version_publish" && entry.outcome === "denied"));
  const shareMode = (await stat(join(root, "desktop", "shares.json"))).mode & 0o077; if (process.platform !== "win32") assert.equal(shareMode, 0, "share index must be private");
  const outsideDirectory = join(root, "outside"); const linkedDirectory = join(workspace, "linked-outside"); await mkdir(outsideDirectory); const outside = join(outsideDirectory, "secret.txt"); await writeFile(outside, "password=outside-secret\n"); await symlink(outsideDirectory, linkedDirectory, "junction"); const linked = join(linkedDirectory, "secret.txt"); const linkedTask = await tasks.enqueueBackgroundTask({ kind: "agent_run", source: "agent", title: "Linked result", status: "completed", workspacePath: workspace, idempotencyKey: "share-source:linked", deliverySummary: { summary: "Linked", artifacts: [{ id: "artifact-link", label: "Link", path: linked, kind: "report" }] } }); await assert.rejects(() => shares.inspectShare({ sourceTaskId: linkedTask.id, scope: "result_only", artifactId: "artifact-link" }), /symbolic-link|outside/i);
  await login("recipient", "recipient@example.test"); const sanitizedDownload = await shares.downloadSharedArtifact({ shareId: secretShare.id, objectId: "artifact-secret" }); const sanitized = Buffer.from(sanitizedDownload.base64, "base64").toString(); assert.doesNotMatch(sanitized, /zyxwvutsrqponmlk|next@example/i); assert.match(sanitized, /已遮蔽秘密/);
  await login("owner", "owner@example.test"); const revoked = await shares.revokeShare({ shareId: manifest.id, confirmation: "REVOKE" }); assert.equal(revoked.objectsInvalidated, 2); const audit = await shares.listShareAudit({ shareId: manifest.id }); assert(audit.some((entry) => entry.outcome === "denied") && audit.some((entry) => entry.action === "revoke"));
  await login("recipient", "recipient@example.test"); assert.equal((await shares.listIncomingShares()).some((item) => item.id === manifest.id), false); await assert.rejects(() => shares.openSharedObject({ shareId: manifest.id, objectType: "artifact", objectId: artifactObject.objectId }), /active|access|available/i); await assert.rejects(() => shares.downloadSharedArtifact({ shareId: manifest.id, objectId: artifactObject.objectId }), /active|access|available/i);
  const stored = JSON.parse(await readFile(join(root, "desktop", "shares.json"), "utf8")); assert.equal(stored.revision > 0, true);
  console.log("Share create, permission, recipient access, download integrity, comments, tasks, version conflict, continuation, audit and revocation passed.");
} finally { await rm(root, { recursive: true, force: true }); }
