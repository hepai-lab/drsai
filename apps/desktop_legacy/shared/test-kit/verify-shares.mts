  await login("recipient", "recipient@example.test"); assert.equal((await shares.listIncomingShares())[0].id, manifest.id);
  const artifactObject = manifest.objects.find((item) => item.objectType === "artifact")!;
  const opened = await shares.openSharedObject({ shareId: manifest.id, objectType: "artifact", objectId: artifactObject.objectId }); assert.equal(opened.authorized, true);
  const download = await shares.downloadSharedArtifact({ shareId: manifest.id, objectId: artifactObject.objectId }); assert.equal(Buffer.from(download.base64, "base64").toString(), "version one\n"); assert.equal(download.sha256, createHash("sha256").update("version one\n").digest("hex"));
  await assert.rejects(() => shares.addShareComment({ shareId: manifest.id, body: "Needs detail", objectId: artifactObject.objectId, anchorType: "paragraph", anchorLabel: "Summary" }), /permission/i);

  await login("owner", "owner@example.test"); await shares.updateSharePermission({ shareId: manifest.id, permission: "comment" });
  await login("recipient", "recipient@example.test"); const comment = await shares.addShareComment({ shareId: manifest.id, body: "Needs detail", objectId: artifactObject.objectId, anchorType: "paragraph", anchorLabel: "Summary" }); assert.equal(comment.target.anchorType, "paragraph");
  await login("owner", "owner@example.test"); const preview = await shares.previewShareCommentTask({ shareId: manifest.id, commentId: comment.id }); const commentTask = await shares.createShareCommentTask({ shareId: manifest.id, commentId: comment.id, title: preview.title, instructions: preview.instructions }); const edited = await shares.updateShareCommentTask({ taskId: commentTask.id, title: "Clarify report", instructions: "Add evidence." }); assert.equal(edited.title, "Clarify report"); assert.equal((await shares.completeShareCommentTask({ taskId: commentTask.id })).status, "completed"); assert.equal((await shares.listShareCommentTasks({ shareId: manifest.id })).length, 1);

  const beforePublishStore = JSON.parse(await readFile(join(root, "desktop", "shares.json"), "utf8")); const oldSnapshot = beforePublishStore.shares[0].internalObjects.find((item: { artifactPath?: string }) => item.artifactPath)?.artifactPath;
  await writeFile(artifactPath, "version two\n"); const version = await shares.inspectShareVersion({ shareId: manifest.id }); assert.equal(version.hasChanges, true); const published = await shares.publishShareVersion({ shareId: manifest.id, expectedVersion: 1, sourceFingerprints: version.sourceFingerprints }); assert.equal(published.currentVersion, 2); await assert.rejects(() => shares.publishShareVersion({ shareId: manifest.id, expectedVersion: 1, sourceFingerprints: version.sourceFingerprints }), /version|changed|conflict/i); if (oldSnapshot) await assert.rejects(access(oldSnapshot), /ENOENT/, "superseded snapshots must be removed after commit");
  const comments = await shares.listShareComments({ shareId: manifest.id }); assert.equal(comments[0].versionStatus, "stale");
