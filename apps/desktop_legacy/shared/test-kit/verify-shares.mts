const root = await mkdtemp(join(tmpdir(), "drsai-shares-")); process.env.DRSAI_HOME = root;
const secrets = new Map<string, string>(); let sequence = 0;
try {
  const [auth, tasks, shares] = await Promise.all([import("../main/auth.ts"), import("../main/backgroundTasks.ts"), import("../main/shares.ts")]);
  auth.configureAuthPlatform({ credentials: { available: () => true, protect: (secret: string) => { const ref = `keychain:share-${++sequence}`; secrets.set(ref, secret); return ref; }, unprotect: (ref?: string) => ref ? secrets.get(ref) : undefined, remove: (ref?: string) => ref ? secrets.delete(ref) : false }, openExternal: async () => undefined });
  const login = async (id: string, email: string) => { await auth.logout().catch(() => undefined); await mkdir(join(root, "auth"), { recursive: true }); await writeFile(join(root, "auth", "session.json"), JSON.stringify({ authenticated: true, authMode: "sso", sessionId: `session-${id}`, createdAt: new Date().toISOString(), expiresAt: new Date(Date.now() + 86_400_000).toISOString(), accessTokenExpiresAt: new Date(Date.now() + 3_600_000).toISOString(), accessToken: `e30.${Buffer.from(JSON.stringify({ exp: Math.floor(Date.now() / 1000) + 3600 })).toString("base64url")}.sig`, refreshToken: `refresh-${id}`, user: { id, email, role: "member" } })); assert.equal((await auth.getAuthSession()).authenticated, true); };
  await login("owner", "owner@example.test");
