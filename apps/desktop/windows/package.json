{
  "name": "opendrsai-windows-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "OpenDrSai Windows desktop shell and installer host",
  "main": "./out/main/index.js",
  "author": "HepAI Team, IHEP <ai@ihep.ac.cn>",
  "homepage": "https://github.com/hepai-lab/drsai",
  "scripts": {
    "dev:bootstrap": "powershell -ExecutionPolicy Bypass -File ..\\..\\..\\scripts\\windows-desktop-dev.ps1",
    "dev:install": "powershell -ExecutionPolicy Bypass -File ..\\..\\..\\scripts\\windows-desktop-dev.ps1 -InstallOnly",
    "dev:repair": "powershell -ExecutionPolicy Bypass -File ..\\..\\..\\scripts\\windows-desktop-dev.ps1 -InstallOnly -ForceInstall",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build": "npm run typecheck && electron-vite build",
    "bundle:backend": "powershell -ExecutionPolicy Bypass -File scripts/create-backend-source-archive.ps1",
    "build:win": "npm run build && npm run bundle:backend && electron-builder --win",
    "build:unpack": "npm run build && npm run bundle:backend && electron-builder --dir",
    "manifest:win": "node scripts/create-windows-manifest.mjs",
    "summary:win": "node scripts/create-release-summary.mjs",
    "sign:bootstrapper": "powershell -ExecutionPolicy Bypass -File scripts/sign-windows-bootstrapper.ps1",
    "verify:manifest": "node scripts/verify-windows-manifest.mjs",
    "verify:chat-sse": "node scripts/verify-chat-sse-parser.mjs",
    "verify:gateway-smoke": "node scripts/verify-gateway-smoke.mjs",
    "verify:artifacts": "node scripts/verify-windows-artifacts.mjs",
    "verify:signatures": "node scripts/verify-windows-signatures.mjs",
    "verify:public-release": "node scripts/verify-public-windows-release.mjs",
    "verify:release-ready": "node scripts/verify-release-readiness.mjs",
    "verify:mojibake": "node scripts/verify-no-mojibake.mjs",
    "verify:ui": "node scripts/verify-renderer-ui.mjs",
    "verify:visual": "node scripts/verify-renderer-visual.mjs",
    "verify:packaged": "node scripts/verify-packaged-app-smoke.mjs",
    "verify:e2e-chat": "node scripts/verify-e2e-chat.mjs",
    "verify:e2e-chat-failures": "node scripts/verify-e2e-chat-failures.mjs",
    "verify:e2e-agent-run": "node scripts/verify-e2e-agent-run.mjs",
    "verify:e2e-agent-run-failures": "node scripts/verify-e2e-agent-run-failures.mjs",
    "verify:e2e-threads": "node scripts/verify-e2e-threads.mjs",
    "verify:install-check": "node scripts/verify-install-checkonly.mjs",
    "verify:install-source": "node scripts/verify-install-source-archive.mjs",
    "verify:backend-bundle": "node scripts/verify-bundled-backend-source.mjs",
    "smoke:clean-win": "powershell -ExecutionPolicy Bypass -File scripts/smoke-clean-windows.ps1",
    "icon:win": "powershell -ExecutionPolicy Bypass -File scripts/create-windows-icon.ps1",
    "verify": "node scripts/verify-windows-app.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/utils": "4.0.0",
    "electron-updater": "6.6.2",
    "lucide-react": "1.7.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "2.0.0",
    "@tailwindcss/vite": "4.2.2",
    "@types/node": "22.20.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "39.8.10",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "tailwindcss": "4.2.2",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
