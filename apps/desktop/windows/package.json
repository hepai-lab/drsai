{
  "name": "opendrsai-windows-desktop",
  "version": "1.5.8",
  "private": true,
  "description": "OpenDrSai Windows desktop shell and installer host",
  "main": "./out/main/index.js",
  "author": "HepAI Team, IHEP <ai@ihep.ac.cn>",
  "homepage": "https://github.com/hepai-lab/drsai",
  "scripts": {
    "dev:bootstrap": "powershell -ExecutionPolicy Bypass -File scripts\\dev.ps1 -InstallPrerequisites",
    "dev:install": "powershell -ExecutionPolicy Bypass -File scripts\\dev.ps1 -InstallOnly",
    "dev:repair": "powershell -ExecutionPolicy Bypass -File scripts\\dev.ps1 -InstallOnly -ForceInstall",
    "dev": "set OPENDRSAI_DESKTOP_DEV=1&& node scripts/run-branded-electron-vite.mjs dev",
    "start": "node scripts/run-branded-electron-vite.mjs preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "verify:desktop-surface": "node ../shared/test-kit/run-typescript-test.mjs ../shared/test-kit/verify-desktop-surface.mts",
    "verify:dev-workspace-startup": "node scripts/verify-dev-workspace-startup.mjs",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir --config.electronDist=../node_modules/electron/dist"
  },
  "dependencies": {
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/utils": "4.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "1.7.0",
    "node-pty": "1.1.0",
    "qrcode": "^1.5.4",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "jszip": "^3.10.1",
    "docx-preview": "^0.3.5"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "2.0.0",
    "@tailwindcss/vite": "4.2.2",
    "@types/node": "22.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "39.8.10",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "tailwindcss": "4.2.2",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
