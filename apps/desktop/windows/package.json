{
  "name": "opendrsai-windows-desktop",
  "version": "2.0.5",
  "private": true,
  "description": "OpenDrSai Windows desktop shell and installer host",
  "main": "./out/main/index.js",
  "author": "HepAI Team, IHEP <ai@ihep.ac.cn>",
  "homepage": "https://github.com/hepai-lab/drsai",
  "scripts": {
    "dev:bootstrap": "powershell -ExecutionPolicy Bypass -File scripts\\dev.ps1 -InstallPrerequisites",
    "dev:install": "powershell -ExecutionPolicy Bypass -File scripts\\dev.ps1 -InstallOnly",
    "dev:repair": "powershell -ExecutionPolicy Bypass -File scripts\\dev.ps1 -InstallOnly -ForceInstall",
    "dev": "set OPENDRSAI_DESKTOP_DEV=1&& node scripts/run-branded-electron-vite.mjs dev",
    "start": "node scripts/run-branded-electron-vite.mjs preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "verify:runtime-client-leases": "node ../shared/test-kit/run-bundled-test.mjs ../shared/test-kit/verify-runtime-client-leases.mts",
    "verify:auth-bootstrap-coordination": "node ../shared/test-kit/run-typescript-test.mjs ../shared/test-kit/verify-auth-bootstrap-coordination.mts",
    "verify:bundled-ripgrep": "node scripts/verify-bundled-ripgrep.mjs",
    "verify:chat-error-presentation": "node ../shared/test-kit/run-bundled-test.mjs ../shared/test-kit/verify-chat-error-presentation.mts",
    "verify:chat-diagnostics-surface": "node ../shared/test-kit/run-bundled-test.mjs ../shared/test-kit/verify-chat-diagnostics-surface.mts",
    "verify:chat-request-transcript": "node ../shared/test-kit/run-bundled-test.mjs ../shared/test-kit/verify-chat-request-transcript.mts",
    "verify:private-mode": "node ../shared/test-kit/run-bundled-test.mjs ../shared/test-kit/verify-private-mode.mts",
    "verify:streaming-persistence": "node ../shared/test-kit/run-bundled-test.mjs ../shared/test-kit/verify-streaming-persistence.mts",
    "verify:terminal-rendering-performance": "node ../shared/test-kit/run-bundled-test.mjs ../shared/test-kit/verify-terminal-rendering-performance.mts",
    "verify:workspace-preview-missing": "node ../shared/test-kit/run-bundled-test.mjs ../shared/test-kit/verify-workspace-preview-missing.mts",
    "verify:structured-process-timeline": "node ../shared/test-kit/run-bundled-test.mjs ../shared/test-kit/verify-structured-process-timeline.mts",
    "verify:tool-lifecycle-projection": "node ../shared/test-kit/run-bundled-test.mjs ../shared/test-kit/verify-tool-lifecycle-projection.mts",
    "verify:desktop-settings-availability": "node ../shared/test-kit/run-bundled-test.mjs ../shared/test-kit/verify-desktop-settings-availability.mts",
    "verify:native-image-validation": "node ../shared/test-kit/run-typescript-test.mjs ../shared/test-kit/verify-native-image-validation.mts",
    "verify:model-provider-simple-setup": "node ../shared/test-kit/run-typescript-test.mjs ../shared/test-kit/verify-model-provider-simple-setup.mts",
    "verify:model-provider-ipc": "node ../shared/test-kit/run-typescript-test.mjs ../shared/test-kit/verify-model-provider-ipc.mts",
    "verify:model-provider-errors": "node ../shared/test-kit/run-typescript-test.mjs ../shared/test-kit/verify-model-provider-errors.mts",
    "verify:model-family-split": "node ../shared/test-kit/run-typescript-test.mjs ../shared/test-kit/verify-model-family-split.mts",
    "verify:session-completion-broadcast": "node ../shared/test-kit/run-bundled-test.mjs ../shared/test-kit/verify-session-completion-broadcast.mts",
    "verify:chat-thread-completion": "node ../shared/test-kit/run-bundled-test.mjs ../shared/test-kit/verify-chat-thread-completion.mts",
    "verify:departed-session-spinner": "node ../shared/test-kit/run-bundled-test.mjs ../shared/test-kit/verify-departed-session-spinner.mts",
    "verify:active-thread-terminal-settle": "node ../shared/test-kit/run-typescript-test.mjs ../shared/test-kit/verify-active-thread-terminal-settle.mts",
    "verify": "npm run verify:chat-error-presentation && npm run verify:chat-diagnostics-surface && npm run verify:chat-request-transcript && npm run verify:private-mode && npm run verify:streaming-persistence && npm run verify:terminal-rendering-performance && npm run verify:structured-process-timeline && npm run verify:tool-lifecycle-projection && npm run verify:desktop-settings-availability && npm run verify:workspace-preview-missing && npm run verify:runtime-client-leases && npm run verify:auth-bootstrap-coordination && npm run verify:native-image-validation && npm run verify:model-provider-simple-setup && npm run verify:model-provider-ipc && npm run verify:model-provider-errors && npm run verify:model-family-split && npm run verify:session-completion-broadcast && npm run verify:chat-thread-completion && npm run verify:departed-session-spinner && npm run verify:active-thread-terminal-settle && npm run verify:bundled-ripgrep && npm run verify:dev-workspace-startup && npm run verify:runtime-defaults",
    "verify:dev-workspace-startup": "node scripts/verify-dev-workspace-startup.mjs",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir --config.electronDist=../node_modules/electron/dist",
    "prepare-ci-python-agent": "powershell -ExecutionPolicy Bypass -File scripts\\prepare-ci-python-agent.ps1",
    "prepare:backend-source": "node scripts\\create-backend-source-archive.mjs",
    "verify:backend-source": "node scripts\\create-backend-source-archive.mjs --check",
    "build:runtime": "npm run verify:backend-source && npm run build:unpack && npm run prepare-ci-python-agent && powershell -ExecutionPolicy Bypass -File installer\\create-opendrsai-runtime.ps1",
    "build:bootstrapper": "powershell -ExecutionPolicy Bypass -File installer\\build-msi.ps1",
    "build:win": "npm run build:runtime && npm run build:bootstrapper",
    "manifest:win": "node scripts\\create-runtime-update-manifest.mjs",
    "summary:win": "node scripts\\create-release-summary.mjs",
    "verify:final-runtime": "powershell -ExecutionPolicy Bypass -File scripts\\verify-current-final-runtime.ps1",
    "verify:runtime-defaults": "node scripts\\verify-runtime-defaults.mjs",
    "verify:windows-artifacts": "node scripts\\verify-windows-artifacts.mjs && powershell -ExecutionPolicy Bypass -File scripts\\verify-windows-msi-contract.ps1",
    "verify:artifacts": "npm run verify:backend-source && npm run verify:runtime-defaults && npm run verify:windows-artifacts",
    "verify:update-manifest": "node scripts\\verify-runtime-update-manifest.mjs",
    "verify:update-helper": "powershell -ExecutionPolicy Bypass -File scripts\\verify-runtime-updater.ps1",
    "verify:e2e-update": "powershell -ExecutionPolicy Bypass -File scripts\\verify-runtime-updater.ps1 -E2E",
    "sign:bootstrapper": "powershell -ExecutionPolicy Bypass -File scripts\\sign-windows-bootstrapper.ps1",
    "verify:signatures": "node scripts\\verify-windows-signatures.mjs",
    "verify:release-ready": "npm run verify:final-runtime && npm run verify:artifacts && npm run verify:update-manifest && npm run verify:update-helper && npm run verify:signatures",
    "verify:public-release": "npm run verify:release-ready && npm run verify:e2e-update",
    "publish:win-to-oss": "powershell -ExecutionPolicy Bypass -File scripts\\publish-windows-release-to-oss.ps1",
    "verify:oss-publishing": "node scripts\\verify-windows-oss-publishing.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/utils": "4.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "docx-preview": "^0.3.5",
    "jszip": "^3.10.1",
    "lucide-react": "1.7.0",
    "node-pty": "1.1.0",
    "pptx-preview": "^1.0.7",
    "qrcode": "^1.5.4",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "2.0.0",
    "@tailwindcss/vite": "4.2.2",
    "@types/node": "22.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "39.8.10",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "tailwindcss": "4.2.2",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
