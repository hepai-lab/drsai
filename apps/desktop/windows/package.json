{
  "name": "opendrsai-windows-desktop",
  "version": "1.4.3-beta.5",
  "private": true,
  "description": "OpenDrSai Windows desktop shell and installer host",
  "main": "./out/main/index.js",
  "author": "HepAI Team, IHEP <ai@ihep.ac.cn>",
  "homepage": "https://github.com/hepai-lab/drsai",
  "scripts": {
    "dev:bootstrap": "powershell -ExecutionPolicy Bypass -File ..\\scripts\\windows-desktop-dev.ps1 -InstallPrerequisites",
    "dev:install": "powershell -ExecutionPolicy Bypass -File ..\\scripts\\windows-desktop-dev.ps1 -InstallOnly",
    "dev:repair": "powershell -ExecutionPolicy Bypass -File ..\\scripts\\windows-desktop-dev.ps1 -InstallOnly -ForceInstall",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "prepare:backend-source": "node scripts/create-backend-source-archive.mjs",
    "verify:bundled-backend-source": "npm run prepare:backend-source && node scripts/verify-bundled-backend-source.mjs",
    "build": "npm run prepare:backend-source && npm run typecheck && electron-vite build",
    "build:win": "npm run build:runtime && npm run build:bootstrapper",
    "build:unpack": "npm run build && electron-builder --dir --config.electronDist=node_modules/electron/dist",
    "build:runtime": "npm run build:unpack && powershell -ExecutionPolicy Bypass -File ..\\installers\\windows\\create-opendrsai-runtime.ps1 -DesktopAppDir release\\win-unpacked",
    "build:bootstrapper": "powershell -ExecutionPolicy Bypass -File ..\\installers\\windows\\build-msi.ps1 -RuntimePath release\\bootstrapper\\OpenDrSaiRuntime-win-x64.zip",
    "generate:fork-import-index": "node scripts/generate-fork-import-index.mjs",
    "summary:win": "node scripts/create-release-summary.mjs",
    "manifest:win": "node scripts/create-runtime-update-manifest.mjs",
    "verify:update-manifest": "node scripts/verify-runtime-update-manifest.mjs",
    "verify:public-release": "node scripts/verify-public-runtime-release.mjs",
    "verify:update-helper": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-runtime-updater.ps1",
    "verify:e2e-update": "node scripts/verify-e2e-runtime-update.mjs",
    "verify:store": "node scripts/verify-store-listing-template.mjs",
    "sign:bootstrapper": "powershell -ExecutionPolicy Bypass -File scripts/sign-windows-bootstrapper.ps1",
    "verify:chat-sse": "node scripts/verify-chat-sse-parser.mjs",
    "verify:chat-output": "node scripts/verify-chat-output-model.mjs",
    "verify:gateway-smoke": "node scripts/verify-gateway-smoke.mjs",
    "verify:startup-performance": "node scripts/verify-startup-performance.mjs",
    "verify:provider-usage-analytics": "node scripts/verify-provider-usage-analytics.mjs",
    "verify:provider-error-analytics": "node scripts/verify-provider-error-analytics.mjs",
    "verify:provider-analytics-api": "node scripts/verify-provider-analytics-api.mjs",
    "verify:provider-analytics-dashboard": "node scripts/verify-provider-analytics-dashboard.mjs",
    "verify:artifacts": "node scripts/verify-windows-artifacts.mjs",
    "verify:signatures": "node scripts/verify-windows-signatures.mjs",
    "verify:release-ready": "node scripts/verify-release-readiness.mjs",
    "verify:preview-browser": "node scripts/verify-preview-browser.mjs",
    "verify:file-previewers": "node scripts/verify-file-previewers.mjs",
    "verify:browser-controller": "node scripts/verify-browser-controller.mjs",
    "verify:browser-use-worker": "node scripts/verify-browser-use-worker.mjs",
    "verify:browser-use-worker-smoke": "node scripts/verify-browser-use-worker-smoke.mjs",
    "verify:mojibake": "node scripts/verify-no-mojibake.mjs",
    "verify:workspace-context": "node scripts/verify-workspace-context.mjs",
    "verify:remote-ssh": "node scripts/verify-remote-ssh.mjs",
    "verify:remote-gateway-real": "node scripts/verify-real-remote-gateway.mjs",
    "verify:remote-ssh-contract": "node scripts/verify-remote-ssh-contract.mjs",
    "verify:workspace-checkpoints": "node scripts/verify-workspace-checkpoints.mjs",
    "verify:chatbar-checklist": "node scripts/verify-chatbar-checklist.mjs",
    "verify:chatbar-status-summary": "node scripts/verify-chatbar-status-summary.mjs",
    "verify:chat-commands": "node scripts/verify-chat-commands.mjs",
    "verify:fork-worktree": "node scripts/verify-fork-worktree.mjs",
    "verify:runtime-mode": "node scripts/verify-runtime-mode.mjs",
    "verify:context-assembler": "node scripts/verify-context-assembler.mjs",
    "verify:ide-context": "node scripts/verify-ide-context.mjs",
    "verify:vscode-ide-producer": "node scripts/verify-vscode-ide-producer.mjs",
    "verify:ide-producers": "node scripts/verify-ide-producers.mjs",
    "verify:project-memory": "node scripts/verify-project-memory.mjs",
    "verify:custom-commands": "node scripts/verify-custom-commands.mjs",
    "verify:workflow-marketplace": "node scripts/verify-workflow-marketplace.mjs",
    "verify:background-tasks": "node scripts/verify-background-tasks.mjs",
    "verify:scheduled-tasks": "node scripts/verify-scheduled-tasks.mjs",
    "verify:execution-policy": "node scripts/verify-execution-policy.mjs",
    "verify:approval-center": "node scripts/verify-approval-center.mjs",
    "verify:external-connections": "node scripts/verify-external-connections.mjs",
    "verify:channel-adapters": "node scripts/verify-channel-adapters.mjs",
    "verify:voice-feature": "node scripts/verify-voice-feature.mjs",
    "test:voice-unit": "node scripts/verify-voice-unit.mjs",
    "test:voice-ipc": "node scripts/verify-voice-ipc.mjs",
    "test:voice-provider": "node scripts/verify-voice-provider.mjs",
    "verify:clipboard-context": "node scripts/verify-clipboard-context.mjs",
    "verify:channel-adapter-route-order": "node scripts/verify-channel-adapter-route-order.mjs",
    "verify:channel-adapter-runtime-fixtures": "node scripts/verify-channel-adapter-runtime-fixtures.mjs",
    "verify:mcp-live-bridge": "node scripts/verify-mcp-live-bridge.mjs",
    "verify:oidc-login": "node scripts/verify-oidc-login.mjs",
    "verify:platform-auth": "node scripts/verify-platform-auth.mjs",
    "verify:live-platform-oidc": "electron scripts/verify-live-platform-oidc.cjs",
    "verify:ui": "node scripts/verify-renderer-ui.mjs",
    "verify:visual": "node scripts/verify-renderer-visual.mjs",
    "verify:packaged": "npm run prepare:backend-source -- --sync-unpacked && node scripts/verify-packaged-app-smoke.mjs",
    "verify:e2e-chat": "node scripts/verify-e2e-chat.mjs",
    "verify:e2e-chat-failures": "node scripts/verify-e2e-chat-failures.mjs",
    "verify:e2e-agent-run": "node scripts/verify-e2e-agent-run.mjs",
    "verify:e2e-agent-run-failures": "node scripts/verify-e2e-agent-run-failures.mjs",
    "verify:e2e-threads": "node scripts/verify-e2e-threads.mjs",
    "verify:e2e-fork-merge": "node scripts/verify-e2e-fork-merge.mjs",
    "verify:e2e-oidc-login": "node scripts/verify-e2e-oidc-login.mjs",
    "verify:e2e-oidc-hai": "node scripts/verify-e2e-oidc-hai.mjs",
    "verify:oidc-dev-env": "node scripts/verify-oidc-dev-env.mjs",
    "verify:install-check": "node scripts/verify-install-checkonly.mjs",
    "verify:thread-menu": "node scripts/verify-thread-context-menu.mjs",
    "smoke:clean-win": "powershell -ExecutionPolicy Bypass -File scripts/smoke-clean-windows.ps1",
    "icon:win": "powershell -ExecutionPolicy Bypass -File scripts/create-windows-icon.ps1",
    "verify": "npm run typecheck && npm run verify:chat-output && npm run verify:chat-sse && npm run verify:oidc-login && npm run verify:platform-auth && npm run verify:workspace-context && npm run verify:workspace-checkpoints && npm run verify:gateway-smoke && npm run verify:startup-performance && npm run verify:ui"
  },
  "dependencies": {
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/utils": "4.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "1.7.0",
    "node-pty": "1.1.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "2.0.0",
    "@tailwindcss/vite": "4.2.2",
    "@types/node": "22.20.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "39.8.10",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "tailwindcss": "4.2.2",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
