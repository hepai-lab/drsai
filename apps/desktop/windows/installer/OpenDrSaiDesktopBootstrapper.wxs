<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="OpenDrSai"
    Language="1033"
    Version="$(var.ProductVersion)"
    Manufacturer="HepAI Team, IHEP"
    UpgradeCode="9E45A2A6-A7D3-45EF-8B14-079E8D7E38E1">
    <Package
      InstallerVersion="500"
      Compressed="yes"
      InstallScope="perMachine"
      InstallPrivileges="elevated"
      Description="OpenDrSai desktop application" />

    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of OpenDrSai Setup is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="RUNTIMEURL" Value="$(var.RuntimeUrl)" />
    <Property Id="RUNTIMESHA256" Value="$(var.RuntimeSha256)" />
    <Property Id="RUNTIMESIZEBYTES" Value="$(var.RuntimeSizeBytes)" />
    <Property Id="BOOTSTRAPPERVERSION" Value="$(var.BootstrapperVersion)" />
    <Property Id="EXTRAINSTALLARGS" Value="$(var.ExtraInstallArgs)" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/hepai-lab/drsai" />
    <Property Id="ARPCONTACT" Value="ai@ihep.ac.cn" />
    <!--
      WixUI_InstallDir displays WiX's placeholder Lorem Ipsum license when the
      product does not provide legally approved terms. OpenDrSai does not ship
      an approved EULA yet, so route directly from Welcome to InstallDir rather
      than presenting placeholder text as a real agreement.
    -->
    <UI Id="OpenDrSaiWixUI_InstallDir">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="WixUI_Mode" Value="InstallDir" />
      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <Publish Dialog="BrowseDlg" Control="OK" Event="DoAction" Value="WixUIValidatePath" Order="3">1</Publish>
      <Publish Dialog="BrowseDlg" Control="OK" Event="SpawnDialog" Value="InvalidDirDlg" Order="4">NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;</Publish>
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999">1</Publish>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg">NOT Installed</Publish>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg">Installed AND PATCH</Publish>
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="DoAction" Value="WixUIValidatePath" Order="2">NOT WIXUI_DONTVALIDATEPATH</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SpawnDialog" Value="InvalidDirDlg" Order="3">NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="4">WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;</Publish>
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2">1</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" Order="1">NOT Installed</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2">Installed AND NOT PATCH</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2">Installed AND PATCH</Publish>
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg">1</Publish>
      <Property Id="ARPNOMODIFY" Value="1" />
    </UI>
    <UIRef Id="WixUI_Common" />
    <UIRef Id="WixUI_ErrorProgressText" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
          <Directory Id="INSTALLFOLDER" Name="OpenDrSai">
            <Component Id="InstallerScripts" Guid="A638D62D-1141-47E5-9316-80D4E54A43AC">
              <File Id="InstallOpenDrSaiScript" Source="$(var.SourceDir)\install-opendrsai.ps1" KeyPath="yes" />
              <File Id="UninstallOpenDrSaiScript" Source="$(var.SourceDir)\uninstall-opendrsai.ps1" />
              <File Id="RunOpenDrSaiInstallScript" Source="$(var.SourceDir)\run-opendrsai-install.vbs" />
              <File Id="RunOpenDrSaiUninstallScript" Source="$(var.SourceDir)\run-opendrsai-uninstall.vbs" />
            </Component>
            <Component Id="ApplicationShortcuts" Guid="DC8D9A19-1035-44A4-A0A8-C92DA51A533D">
              <Shortcut Id="StartMenuShortcut" Directory="OpenDrSaiProgramMenu" Name="OpenDrSai"
                Description="OpenDrSai" Target="[INSTALLFOLDER]app\OpenDrSai.exe"
                WorkingDirectory="INSTALLFOLDER" />
              <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="OpenDrSai"
                Description="OpenDrSai" Target="[INSTALLFOLDER]app\OpenDrSai.exe"
                WorkingDirectory="INSTALLFOLDER" />
              <RemoveFolder Id="RemoveOpenDrSaiProgramMenu" Directory="OpenDrSaiProgramMenu" On="uninstall" />
              <RegistryValue Root="HKLM" Key="Software\HepAI\OpenDrSai" Name="Installed"
                Type="integer" Value="1" KeyPath="yes" />
            </Component>
          </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="OpenDrSaiProgramMenu" Name="OpenDrSai" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>

    <Feature Id="MainFeature" Title="OpenDrSai Setup" Level="1">
      <ComponentRef Id="InstallerScripts" />
      <ComponentRef Id="ApplicationShortcuts" />
    </Feature>

    <Binary Id="OpenDrSaiInstallerActions" SourceFile="$(var.InstallerActionsPath)" />

    <CustomAction Id="SetDownloadOpenDrSaiRuntime" Property="DownloadOpenDrSaiRuntime"
      Value='RuntimeUrl=[RUNTIMEURL];SourcePath=[OriginalDatabase];TargetPath=[INSTALLFOLDER]cache\OpenDrSai-Windows-v[BOOTSTRAPPERVERSION]-x64.zip;ExpectedSize=[RUNTIMESIZEBYTES];BootstrapperVersion=[BOOTSTRAPPERVERSION]' />
    <CustomAction Id="SetVerifyOpenDrSaiRuntime" Property="VerifyOpenDrSaiRuntime"
      Value='-NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -File "[INSTALLFOLDER]install-opendrsai.ps1" -Stage Verify -InstallRoot "[INSTALLFOLDER]." -RuntimeUrl "[RUNTIMEURL]" -RuntimeSha256 "[RUNTIMESHA256]" -RuntimeSizeBytes "[RUNTIMESIZEBYTES]" -BootstrapperVersion "[BOOTSTRAPPERVERSION]" -MachineInstall -NoShortcuts -NoLaunch [EXTRAINSTALLARGS]' />
    <CustomAction Id="SetExtractOpenDrSaiRuntime" Property="ExtractOpenDrSaiRuntime"
      Value='-NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -File "[INSTALLFOLDER]install-opendrsai.ps1" -Stage Extract -InstallRoot "[INSTALLFOLDER]." -RuntimeUrl "[RUNTIMEURL]" -RuntimeSha256 "[RUNTIMESHA256]" -RuntimeSizeBytes "[RUNTIMESIZEBYTES]" -BootstrapperVersion "[BOOTSTRAPPERVERSION]" -MachineInstall -NoShortcuts -NoLaunch [EXTRAINSTALLARGS]' />
    <CustomAction Id="SetInstallOpenDrSaiRuntime" Property="InstallOpenDrSaiRuntime"
      Value='-NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -File "[INSTALLFOLDER]install-opendrsai.ps1" -Stage Install -InstallRoot "[INSTALLFOLDER]." -RuntimeUrl "[RUNTIMEURL]" -RuntimeSha256 "[RUNTIMESHA256]" -RuntimeSizeBytes "[RUNTIMESIZEBYTES]" -BootstrapperVersion "[BOOTSTRAPPERVERSION]" -MachineInstall -NoShortcuts -NoLaunch [EXTRAINSTALLARGS]' />
    <CustomAction Id="SetCompleteOpenDrSaiInstall" Property="CompleteOpenDrSaiInstall"
      Value='-NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -File "[INSTALLFOLDER]install-opendrsai.ps1" -Stage Complete -InstallRoot "[INSTALLFOLDER]." -RuntimeUrl "[RUNTIMEURL]" -RuntimeSha256 "[RUNTIMESHA256]" -RuntimeSizeBytes "[RUNTIMESIZEBYTES]" -BootstrapperVersion "[BOOTSTRAPPERVERSION]" -MachineInstall -NoShortcuts -NoLaunch [EXTRAINSTALLARGS]' />
    <CustomAction Id="SetRunOpenDrSaiUninstaller" Property="RunOpenDrSaiUninstaller"
      Value='-NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -File "[INSTALLFOLDER]uninstall-opendrsai.ps1" -InstallRoot "[INSTALLFOLDER]."' />
    <CustomAction Id="SetAdvanceVerifyProgress" Property="AdvanceVerifyProgress" Value='Ticks=50' />
    <CustomAction Id="SetAdvanceExtractProgress" Property="AdvanceExtractProgress" Value='Ticks=200' />
    <CustomAction Id="SetAdvanceInstallProgress" Property="AdvanceInstallProgress" Value='Ticks=120' />
    <CustomAction Id="SetAdvanceCompleteProgress" Property="AdvanceCompleteProgress" Value='Ticks=30' />

    <CustomAction Id="DownloadOpenDrSaiRuntime" BinaryKey="OpenDrSaiInstallerActions" DllEntry="DownloadRuntime"
      Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="VerifyOpenDrSaiRuntime" Directory="INSTALLFOLDER" ExeCommand='powershell.exe [VerifyOpenDrSaiRuntime]'
      Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="ExtractOpenDrSaiRuntime" Directory="INSTALLFOLDER" ExeCommand='powershell.exe [ExtractOpenDrSaiRuntime]'
      Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="InstallOpenDrSaiRuntime" Directory="INSTALLFOLDER" ExeCommand='powershell.exe [InstallOpenDrSaiRuntime]'
      Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="CompleteOpenDrSaiInstall" Directory="INSTALLFOLDER" ExeCommand='powershell.exe [CompleteOpenDrSaiInstall]'
      Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="RunOpenDrSaiUninstaller" Directory="INSTALLFOLDER" ExeCommand='powershell.exe [RunOpenDrSaiUninstaller]'
      Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="AdvanceVerifyProgress" BinaryKey="OpenDrSaiInstallerActions" DllEntry="AdvanceProgress"
      Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="AdvanceExtractProgress" BinaryKey="OpenDrSaiInstallerActions" DllEntry="AdvanceProgress"
      Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="AdvanceInstallProgress" BinaryKey="OpenDrSaiInstallerActions" DllEntry="AdvanceProgress"
      Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="AdvanceCompleteProgress" BinaryKey="OpenDrSaiInstallerActions" DllEntry="AdvanceProgress"
      Execute="deferred" Impersonate="no" Return="check" />

    <InstallExecuteSequence>
      <Custom Action="SetDownloadOpenDrSaiRuntime" After="InstallFiles">NOT Installed</Custom>
      <Custom Action="DownloadOpenDrSaiRuntime" After="SetDownloadOpenDrSaiRuntime">NOT Installed</Custom>
      <Custom Action="SetVerifyOpenDrSaiRuntime" After="DownloadOpenDrSaiRuntime">NOT Installed</Custom>
      <Custom Action="VerifyOpenDrSaiRuntime" After="SetVerifyOpenDrSaiRuntime">NOT Installed</Custom>
      <Custom Action="SetAdvanceVerifyProgress" After="VerifyOpenDrSaiRuntime">NOT Installed</Custom>
      <Custom Action="AdvanceVerifyProgress" After="SetAdvanceVerifyProgress">NOT Installed</Custom>
      <Custom Action="SetExtractOpenDrSaiRuntime" After="AdvanceVerifyProgress">NOT Installed</Custom>
      <Custom Action="ExtractOpenDrSaiRuntime" After="SetExtractOpenDrSaiRuntime">NOT Installed</Custom>
      <Custom Action="SetAdvanceExtractProgress" After="ExtractOpenDrSaiRuntime">NOT Installed</Custom>
      <Custom Action="AdvanceExtractProgress" After="SetAdvanceExtractProgress">NOT Installed</Custom>
      <Custom Action="SetInstallOpenDrSaiRuntime" After="AdvanceExtractProgress">NOT Installed</Custom>
      <Custom Action="InstallOpenDrSaiRuntime" After="SetInstallOpenDrSaiRuntime">NOT Installed</Custom>
      <Custom Action="SetAdvanceInstallProgress" After="InstallOpenDrSaiRuntime">NOT Installed</Custom>
      <Custom Action="AdvanceInstallProgress" After="SetAdvanceInstallProgress">NOT Installed</Custom>
      <Custom Action="SetCompleteOpenDrSaiInstall" After="AdvanceInstallProgress">NOT Installed</Custom>
      <Custom Action="CompleteOpenDrSaiInstall" After="SetCompleteOpenDrSaiInstall">NOT Installed</Custom>
      <Custom Action="SetAdvanceCompleteProgress" After="CompleteOpenDrSaiInstall">NOT Installed</Custom>
      <Custom Action="AdvanceCompleteProgress" After="SetAdvanceCompleteProgress">NOT Installed</Custom>
      <Custom Action="SetRunOpenDrSaiUninstaller" Before="RunOpenDrSaiUninstaller">REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="RunOpenDrSaiUninstaller" Before="RemoveFiles">REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>

    <UI>
      <Error Id="25001">OpenDrSai Runtime download failed: [2]</Error>
      <ProgressText Action="DownloadOpenDrSaiRuntime" Template="[1]">Downloading OpenDrSai Runtime...</ProgressText>
      <ProgressText Action="VerifyOpenDrSaiRuntime">Verifying the downloaded package...</ProgressText>
      <ProgressText Action="ExtractOpenDrSaiRuntime">Extracting OpenDrSai Runtime...</ProgressText>
      <ProgressText Action="InstallOpenDrSaiRuntime">Installing OpenDrSai...</ProgressText>
      <ProgressText Action="CompleteOpenDrSaiInstall">Finishing OpenDrSai installation...</ProgressText>
      <ProgressText Action="RunOpenDrSaiUninstaller">Removing OpenDrSai Runtime...</ProgressText>
    </UI>
  </Product>
</Wix>
