# Android source and tests share names with generic generated-data rules above.
!apps/android/app/src/main/java/ai/drsai/remote/data/
!apps/android/app/src/main/java/ai/drsai/remote/data/**
!apps/android/app/src/test/
!apps/android/app/src/test/**

# Android acceptance-test artifacts and device screenshots are generated locally.
docs/android/testing/acceptance/**/device/*.png
docs/android/testing/acceptance/**/emulator-results/
device.png

# Local validation evidence and approval notes; never commit runtime databases,
# captured schemas, or machine-specific proof files.
.artifacts/
approval-proof.txt

# Raw device/UI captures are local validation output. Keep the curated JSON
# acceptance ledgers and release manifests in docs, but do not accumulate
# screenshots, accessibility dumps, or unfinished probe output in Git.
docs/android/reports/evidence/**/*.png
docs/android/reports/evidence/**/*.xml
docs/android/reports/evidence/p9/pending/
docs/android/reports/evidence/round*.*
docs/android/reports/evidence/samsung-model-provider-*/
docs/android/reports/preflight/**/*.png
docs/android/reports/preflight/**/*.xml
docs/android/reports/preflight/**/*.txt
docs/desktop/evidence/**/*.png
docs/desktop/evidence/**/accessibility-tree.json
docs/desktop/evidence/round*/

# Desktop renderer bundles are reproducible build output.
apps/desktop/shared/renderer/out/

# Windows packaging consumes these two brand assets from buildResources.
# Keep other generated build directories ignored while making clean/CI builds branded.
!apps/desktop/windows/build/
apps/desktop/windows/build/*
!apps/desktop/windows/build/icon.ico
!apps/desktop/windows/build/icon.png
