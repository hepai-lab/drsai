# ---------------------------------------------
# 智能体服务配置
# 官方平台地址请在 ~/.drsai/config.toml 中通过 active_platform 和
# [platforms.<name>] 的 portal_url/base_url 配置。
# ---------------------------------------------
# SYSTEM_SKILLS_DIR="/path/to/skills"
# LLM_CONFIG_FILE="/path/to/llm_config.json"

# ---------------------------------------------
# 对话记忆上下文类型
# "sqlite" - 使用本地SQLite存储（默认，无需RAGFlow）
# "ragflow" - 使用RAGFlow矢量知识库（需要配置RAGFLOW_URL/TOKEN和MEMORY_DATASET_ID）
# ---------------------------------------------
DRSAI_CONTEXT_TYPE="sqlite"
RAGFLOW_URL="https://ragflow.ihep.ac.cn"
RAGFLOW_TOKEN="ragflow-***"
MEMORY_DATASET_ID="***"

# ---------------------------------------------
# VNC服务配置，需要官网地址和端口开放
# ---------------------------------------------
# VNC_SERVICE_URL="http://**/api/vncapi"
# MIN_PORT="40000"
# MAX_PORT="65000"

# ---------------------------------------------
# 是否将前端上传的文件上传到文件系统
# ---------------------------------------------
# USE_HEPAI_FILE=true

# ---------------------------------------------
# 前端默认展示的智能体（公共 remote 目录，可选）
# 不设则广场不预置 remote 条目。复制样例后改成本机/部署路径：
#   cp apps/webui/backend/remote_agents.example.json apps/webui/backend/remote_agents.json
# ---------------------------------------------
# DEFAULT_REMOTE_AGENTS="/absolute/path/to/apps/webui/backend/remote_agents.json"

# ---------------------------------------------
# 新用户默认智能体（首次登录 / 无使用记录时）
# ---------------------------------------------
# DRSUI_AUTO_LOAD_DEFAULT_AGENT=true
# 为 true 时，从 /user_agents/list 中按名称匹配并自动选中；为 false 时引导用户去智能体广场
# DRSUI_DEFAULT_AGENT_NAME="Your Agent Name"

# ------------#
# 开发环境配置 #
# ------------#
SERVICE_MODE="DEV"
# 访问LLM和文件系统的API-KEY,通过ai.ihep.ac.cn获取
# HEPAI_API_KEY="<enter your key here>"

# 本地登录默认账号（DEV 模式启动时自动创建，账号已存在则跳过）
# DRSAI_UI_DEFAULT_ADMIN_USER="admin"
# DRSAI_UI_DEFAULT_ADMIN_PASSWORD="admin123456"
# DRSAI_UI_DEFAULT_DEV_USER="dev"
# DRSAI_UI_DEFAULT_DEV_PASSWORD="dev123456"

# ---------------------------------------------
# 生产环境配置（不需要统一认证和多用户时可不设置），使用生产环境时将SERVICE MODE改为PROD
# ---------------------------------------------

# SERVICE_MODE="PROD"
# # 统一身份认证配置，从login.ihep.ac.cn获取（旧 IHEP SSO，/umt/login）
# IHEP_SSO_APP_KEY="**"
# IHEP_SSO_APP_SECRET="**"
# IHEP_SSO_REDIRECT_URI="**"

# HepAI OIDC（confidential + PKCE S256）。生产登录走 /auth/login。
# 反向代理须把 /auth/login、/auth/oidc/callback、/api/auth/me 转到 FastAPI，
# 并传递 Host、X-Forwarded-Host、X-Forwarded-Proto=https。
# OIDC_ISSUER="https://ai-dev.ihep.ac.cn/api"
# OIDC_CLIENT_ID="opendrsai-webui"
# OIDC_CLIENT_SECRET="**"
# OIDC_SCOPE="openid email profile hai_api offline_access"
# SESSION_SECRET="**"   # openssl rand -hex 32
# OIDC_ALLOWED_REDIRECT_URIS="https://opendrsai.ihep.ac.cn/auth/oidc/callback https://drsaiv2.ihep.ac.cn/auth/oidc/callback"

# 微信开放平台桌面登录配置
# 在微信开放平台中配置回调地址：
# https://opendrsai.ihep.ac.cn/api/desktop-auth/wechat/callback
# WECHAT_LOGIN_APP_ID="**"
# WECHAT_LOGIN_APP_SECRET="**"
# WECHAT_LOGIN_REDIRECT_URI="https://opendrsai.ihep.ac.cn/api/desktop-auth/wechat/callback"
# WECHAT_LOGIN_SCOPE="snsapi_login"

# # HepAI子应用配置，从hepai@ihep.ac.cn获取
# HEPAI_APP_ADMIN_API_KEY="**"

# ---------------------------------------------
# Skill proxy 内部鉴权（远程 agent 调 /api/agent/skills）
# 请求头 X-Skill-Proxy-Token；与 DeerFlow / Higraf token 无关
# 未配置时 skill 接口会 401
# ---------------------------------------------
DRSAI_SKILL_PROXY_TOKEN=""

# ---------------------------------------------
# GFS（高能所文件系统）集成 — 让 agent 通过 function-calling 读写 GFS 用户 bucket
# 详见 cores/python/packages/drsai/docs/gfs-integration.md
# ---------------------------------------------
# 总开关：未设置或 false 时不挂任何 GFS 工具
# DRSAI_GFS_ENABLED=true

# 模式选择：personal（个人）/ admin（管理员）/ 留空自动判定
# - personal: 用自己的 AKSK，不需要 GFS_OPENAPI_KEY；适合本地 / 单用户实例
# - admin   : worker 持管理员 key，自动为登录用户拿 AKSK；适合多用户服务
# - 留空    : 检测到完整 GFS_ACCESS_KEY/SECRET_KEY/BUCKET 时走 personal，否则 admin
# DRSAI_GFS_MODE=personal

# ---- 模式 A: personal（个人） ----
# 凭证可在 https://gfs.ihep.ac.cn 网页端"密钥管理"页拿到
# GFS_ACCESS_KEY="**"
# GFS_SECRET_KEY="**"
# GFS_BUCKET="20235-xiongdb"          # 完整桶名（不是短名）
# GFS_USER_EMAIL="xiongdb@ihep.ac.cn" # 可选，仅用于日志

# ---- 模式 B: admin（多用户服务） ----
# 向程耀东 / 李海波申请管理员 X-API-Key
# GFS_OPENAPI_KEY="**"

# ---- 通用（两种模式都可选） ----
# GFS_OPENAPI_BASE="http://gfs.ihep.ac.cn:7800"
# GFS_S3_ENDPOINT="https://fgws3-gfs.ihep.ac.cn"
# DRSAI_GFS_CACHE_DIR="~/.drsai/.cache/gfs"  # 仅 admin 模式落盘 AKSK 用

