{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendrsai.local/schemas/owop/1.0/owop.schema.json",
  "title": "OpenDrSai Workspace Operation Protocal",
  "version": "1.0",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/failure" },
    { "$ref": "#/$defs/event" }
  ],
  "x-owop-capabilities": ["workspace", "worktree", "files", "search", "watch", "git", "process", "pty", "checkpoint", "artifact"],
  "x-owop-bindings": ["in_process", "local_ipc", "ssh", "hepai_if", "mcp", "ddf", "relay"],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9_.:-]+$" },
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "worktreeResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worktree_id", "source_workspace_id", "workspace_id", "repo_root", "canonical_path", "branch", "base_commit", "status", "location", "created_at", "updated_at"],
      "properties": {
        "worktree_id": { "$ref": "#/$defs/id" },
        "source_workspace_id": { "$ref": "#/$defs/id" },
        "workspace_id": { "type": ["string", "null"] },
        "repo_root": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "canonical_path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "branch": { "type": "string", "minLength": 1, "maxLength": 255 },
        "base_commit": { "type": "string", "minLength": 7, "maxLength": 128 },
        "status": { "enum": ["creating", "active", "review", "merge_pending", "merged", "archived", "removing", "removed"] },
        "location": { "enum": ["local", "remote"] },
        "source_dirty": { "type": "boolean" },
        "source_status_summary": { "type": ["string", "null"], "maxLength": 4000 },
        "created_at": { "type": "string", "minLength": 1 },
        "updated_at": { "type": "string", "minLength": 1 },
        "removed_at": { "type": ["string", "null"] },
        "last_error_code": { "type": ["string", "null"] },
        "last_error_message": { "type": ["string", "null"] },
        "head_commit": { "type": ["string", "null"], "minLength": 7, "maxLength": 128 },
        "dirty": { "type": "boolean" },
        "ahead": { "type": "integer", "minimum": 0 },
        "behind": { "type": "integer", "minimum": 0 },
        "activity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sessions", "runs", "terminals", "total"],
          "properties": {
            "sessions": { "type": "integer", "minimum": 0 },
            "runs": { "type": "integer", "minimum": 0 },
            "terminals": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "terminalResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal_id", "runtime_id", "workspace_id", "worktree_id", "cwd", "argv", "status", "generation", "pid", "cols", "rows", "created_at", "updated_at", "exited_at", "exit_code", "exit_signal", "last_sequence", "first_sequence", "journal_bytes"],
      "properties": {
        "terminal_id": { "$ref": "#/$defs/id" },
        "runtime_id": { "$ref": "#/$defs/id" },
        "workspace_id": { "$ref": "#/$defs/id" },
        "worktree_id": { "type": ["string", "null"] },
        "cwd": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "shell": { "type": ["string", "null"] },
        "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "status": { "enum": ["starting", "running", "detached", "reconnecting", "exited", "lost"] },
        "generation": { "type": "integer", "minimum": 1 },
        "pid": { "type": ["integer", "null"] },
        "cols": { "type": "integer", "minimum": 1 },
        "rows": { "type": "integer", "minimum": 1 },
        "created_at": { "type": "number" },
        "updated_at": { "type": "number" },
        "exited_at": { "type": ["number", "null"] },
        "exit_code": { "type": ["integer", "null"] },
        "exit_signal": { "type": ["string", "null"] },
        "last_sequence": { "type": "integer", "minimum": 0 },
        "first_sequence": { "type": "integer", "minimum": 1 },
        "journal_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "terminalOutputEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal_id", "runtime_id", "workspace_id", "worktree_id", "generation", "sequence", "created_at", "content_base64"],
      "properties": {
        "terminal_id": { "$ref": "#/$defs/id" },
        "runtime_id": { "$ref": "#/$defs/id" },
        "workspace_id": { "$ref": "#/$defs/id" },
        "worktree_id": { "type": ["string", "null"] },
        "generation": { "type": "integer", "minimum": 1 },
        "sequence": { "type": "integer", "minimum": 1 },
        "created_at": { "type": "number" },
        "content_base64": { "type": "string" }
      }
    },
    "terminalScreenRun": {
      "type": "object", "additionalProperties": false, "required": ["text", "style"],
      "properties": {
        "text": { "type": "string" },
        "style": { "type": "object", "additionalProperties": false, "properties": {
          "fg": { "type": "string" }, "bg": { "type": "string" },
          "bold": { "type": "boolean" }, "underline": { "type": "boolean" }, "inverse": { "type": "boolean" }
        } }
      }
    },
    "terminalScreenSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "snapshot_sequence", "generation", "rows", "cols", "cursor", "alternate_screen", "bracketed_paste", "scrollback", "screen"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "snapshot_sequence": { "type": "integer", "minimum": 0 },
        "generation": { "type": "integer", "minimum": 1 },
        "rows": { "type": "integer", "minimum": 1 }, "cols": { "type": "integer", "minimum": 1 },
        "cursor": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": {
          "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 }
        } },
        "alternate_screen": { "type": "boolean" }, "bracketed_paste": { "type": "boolean" },
        "scrollback": { "type": "array", "items": { "type": "array", "items": { "$ref": "#/$defs/terminalScreenRun" } } },
        "screen": { "type": "array", "items": { "type": "array", "items": { "$ref": "#/$defs/terminalScreenRun" } } }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["in_process", "local_ipc", "ssh", "hepai_if", "mcp", "ddf", "relay"] },
        "endpoint": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "host_alias": { "type": "string", "minLength": 1, "maxLength": 255 },
        "socket_path": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "request_id", "correlation_id", "workspace_id", "operation", "params", "binding"],
      "properties": {
        "version": { "const": "1.0" },
        "request_id": { "$ref": "#/$defs/id" },
        "correlation_id": { "$ref": "#/$defs/id" },
        "workspace_id": { "$ref": "#/$defs/id" },
        "operation": { "type": "string", "minLength": 1 },
        "params": { "type": "object" },
        "binding": { "$ref": "#/$defs/binding" }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "request_id", "correlation_id", "ok", "result"],
      "properties": {
        "version": { "const": "1.0" },
        "request_id": { "$ref": "#/$defs/id" },
        "correlation_id": { "$ref": "#/$defs/id" },
        "ok": { "const": true },
        "result": { "type": "object" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "correlation_id", "retryable", "details"],
      "properties": {
        "code": { "$ref": "#/$defs/id" },
        "message": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "correlation_id": { "$ref": "#/$defs/id" },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "request_id", "correlation_id", "ok", "error"],
      "properties": {
        "version": { "const": "1.0" },
        "request_id": { "$ref": "#/$defs/id" },
        "correlation_id": { "$ref": "#/$defs/id" },
        "ok": { "const": false },
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "event_id", "workspace_id", "sequence", "resource_sequence", "cursor", "dedupe_key", "type", "data"],
      "properties": {
        "version": { "const": "1.0" },
        "event_id": { "$ref": "#/$defs/id" },
        "workspace_id": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1 },
        "resource_sequence": { "type": "integer", "minimum": 1 },
        "cursor": { "type": "string", "minLength": 1, "maxLength": 512 },
        "dedupe_key": { "$ref": "#/$defs/id" },
        "type": { "enum": ["workspace.opened", "workspace.closed", "worktree.created", "worktree.status_changed", "worktree.conflict", "worktree.merged", "worktree.archived", "worktree.removed", "file.created", "file.changed", "file.removed", "file.renamed", "git.changed", "process.output", "process.exited", "pty.output", "pty.exited", "checkpoint.changed", "artifact.changed", "unknown"] },
        "data": { "type": "object" }
      }
    }
  },
  "x-owop-operations": {
    "workspace.describe": { "type": "object", "additionalProperties": false, "properties": {} },
    "files.list": { "type": "object", "additionalProperties": false, "required": ["path", "limit"], "properties": { "path": { "$ref": "#/$defs/relativePath" }, "cursor": { "type": "string" }, "depth": { "type": "integer", "minimum": 1, "maximum": 4 }, "limit": { "type": "integer", "minimum": 1, "maximum": 1000 } } },
    "files.stat": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "$ref": "#/$defs/relativePath" } } },
    "files.read": { "type": "object", "additionalProperties": false, "required": ["path", "offset", "length"], "properties": { "path": { "$ref": "#/$defs/relativePath" }, "offset": { "type": "integer", "minimum": 0 }, "length": { "type": "integer", "minimum": 1, "maximum": 8388608 } } },
    "files.write": { "type": "object", "additionalProperties": false, "required": ["path", "content_base64"], "properties": { "path": { "$ref": "#/$defs/relativePath" }, "content_base64": { "type": "string" }, "expected_digest": { "$ref": "#/$defs/digest" }, "create_parents": { "type": "boolean" } } },
    "files.move": { "type": "object", "additionalProperties": false, "required": ["source", "destination"], "properties": { "source": { "$ref": "#/$defs/relativePath" }, "destination": { "$ref": "#/$defs/relativePath" }, "expected_digest": { "$ref": "#/$defs/digest" } } },
    "files.remove": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "$ref": "#/$defs/relativePath" }, "expected_digest": { "$ref": "#/$defs/digest" }, "recursive": { "type": "boolean" } } },
    "search.query": { "type": "object", "additionalProperties": false, "required": ["query", "limit"], "properties": { "query": { "type": "string", "minLength": 1, "maxLength": 2000 }, "path": { "$ref": "#/$defs/relativePath" }, "cursor": { "type": "string" }, "limit": { "type": "integer", "minimum": 1, "maximum": 1000 }, "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 10000 }, "include_ignored": { "type": "boolean" } } },
    "watch.subscribe": { "type": "object", "additionalProperties": false, "required": ["after_sequence"], "properties": { "path": { "$ref": "#/$defs/relativePath" }, "after_sequence": { "type": "integer", "minimum": 0 }, "limit": { "type": "integer", "minimum": 1, "maximum": 5000 } } },
    "git.status": { "type": "object", "additionalProperties": false, "properties": {} },
    "git.diff": { "type": "object", "additionalProperties": false, "properties": { "path": { "$ref": "#/$defs/relativePath" }, "staged": { "type": "boolean" } } },
    "git.file_at_ref": { "type": "object", "additionalProperties": false, "required": ["path", "ref"], "properties": { "path": { "$ref": "#/$defs/relativePath" }, "ref": { "type": "string", "minLength": 1, "maxLength": 255 }, "max_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 } } },
    "git.stage": { "type": "object", "additionalProperties": false, "required": ["paths"], "properties": { "paths": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/relativePath" } } } },
    "git.unstage": { "type": "object", "additionalProperties": false, "required": ["paths"], "properties": { "paths": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/relativePath" } } } },
    "git.revert": { "type": "object", "additionalProperties": false, "required": ["paths", "diff_digest"], "properties": { "paths": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/relativePath" } }, "diff_digest": { "$ref": "#/$defs/digest" } } },
    "git.commit": { "type": "object", "additionalProperties": false, "required": ["message", "diff_digest"], "properties": { "message": { "type": "string", "minLength": 1, "maxLength": 4000 }, "diff_digest": { "$ref": "#/$defs/digest" } } },
    "git.worktree.list": { "type": "object", "additionalProperties": false, "properties": { "include_removed": { "type": "boolean" } } },
    "git.worktree.create": { "type": "object", "additionalProperties": false, "required": ["idempotency_key", "intent"], "properties": { "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 256 }, "intent": { "type": "string", "minLength": 1, "maxLength": 180 } } },
    "git.worktree.describe": { "type": "object", "additionalProperties": false, "required": ["worktree_id"], "properties": { "worktree_id": { "$ref": "#/$defs/id" } } },
    "git.worktree.merge": { "type": "object", "additionalProperties": false, "required": ["worktree_id", "idempotency_key"], "properties": { "worktree_id": { "$ref": "#/$defs/id" }, "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 256 }, "expected_head": { "type": "string", "minLength": 7, "maxLength": 128 } } },
    "git.worktree.archive": { "type": "object", "additionalProperties": false, "required": ["worktree_id", "idempotency_key"], "properties": { "worktree_id": { "$ref": "#/$defs/id" }, "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 256 } } },
    "git.worktree.remove": { "type": "object", "additionalProperties": false, "required": ["worktree_id", "expected_status", "idempotency_key"], "properties": { "worktree_id": { "$ref": "#/$defs/id" }, "expected_status": { "enum": ["merged", "archived"] }, "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 256 } } },
    "git.worktree.prune": { "type": "object", "additionalProperties": false, "required": ["dry_run", "idempotency_key"], "properties": { "dry_run": { "type": "boolean" }, "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 256 } } },
    "process.start": { "type": "object", "additionalProperties": false, "required": ["argv", "cwd"], "properties": { "argv": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 32768 } }, "cwd": { "$ref": "#/$defs/relativePath" }, "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 3600000 }, "max_output_bytes": { "type": "integer", "minimum": 1024, "maximum": 67108864 } } },
    "process.write": { "type": "object", "additionalProperties": false, "required": ["process_id", "content_base64"], "properties": { "process_id": { "$ref": "#/$defs/id" }, "content_base64": { "type": "string" } } },
    "process.attach": { "type": "object", "additionalProperties": false, "required": ["process_id", "after_offset"], "properties": { "process_id": { "$ref": "#/$defs/id" }, "after_offset": { "type": "integer", "minimum": 0 } } },
    "process.kill": { "type": "object", "additionalProperties": false, "required": ["process_id"], "properties": { "process_id": { "$ref": "#/$defs/id" }, "tree": { "type": "boolean" } } },
    "pty.list": { "type": "object", "additionalProperties": false, "properties": {} },
    "pty.describe": { "type": "object", "additionalProperties": false, "required": ["pty_id"], "properties": { "pty_id": { "$ref": "#/$defs/id" } } },
    "pty.create": { "type": "object", "additionalProperties": false, "required": ["argv", "cwd", "cols", "rows"], "properties": { "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "cwd": { "$ref": "#/$defs/relativePath" }, "cols": { "type": "integer", "minimum": 1, "maximum": 1000 }, "rows": { "type": "integer", "minimum": 1, "maximum": 1000 }, "max_buffer_bytes": { "type": "integer", "minimum": 1024, "maximum": 16777216 } } },
    "pty.write": { "type": "object", "additionalProperties": false, "required": ["pty_id", "lease_id", "content_base64"], "properties": { "pty_id": { "$ref": "#/$defs/id" }, "lease_id": { "$ref": "#/$defs/id" }, "content_base64": { "type": "string" } } },
    "pty.resize": { "type": "object", "additionalProperties": false, "required": ["pty_id", "lease_id", "cols", "rows"], "properties": { "pty_id": { "$ref": "#/$defs/id" }, "lease_id": { "$ref": "#/$defs/id" }, "cols": { "type": "integer", "minimum": 1, "maximum": 1000 }, "rows": { "type": "integer", "minimum": 1, "maximum": 1000 } } },
    "pty.attach": { "type": "object", "additionalProperties": false, "required": ["pty_id", "client_id", "mode", "after_sequence"], "properties": { "pty_id": { "$ref": "#/$defs/id" }, "lease_id": { "$ref": "#/$defs/id" }, "client_id": { "$ref": "#/$defs/id" }, "mode": { "enum": ["reader", "writer"] }, "after_sequence": { "type": "integer", "minimum": 0 }, "lease_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 }, "prefer_snapshot": { "type": "boolean" } } },
    "pty.detach": { "type": "object", "additionalProperties": false, "required": ["pty_id", "lease_id"], "properties": { "pty_id": { "$ref": "#/$defs/id" }, "lease_id": { "$ref": "#/$defs/id" } } },
    "pty.kill": { "type": "object", "additionalProperties": false, "required": ["pty_id"], "properties": { "pty_id": { "$ref": "#/$defs/id" } } },
    "checkpoint.create": { "type": "object", "additionalProperties": false, "properties": { "label": { "type": "string", "maxLength": 240 }, "max_file_bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 } } },
    "checkpoint.preview": { "type": "object", "additionalProperties": false, "required": ["checkpoint_id"], "properties": { "checkpoint_id": { "$ref": "#/$defs/id" } } },
    "checkpoint.restore": { "type": "object", "additionalProperties": false, "required": ["checkpoint_id", "preview_digest"], "properties": { "checkpoint_id": { "$ref": "#/$defs/id" }, "preview_digest": { "$ref": "#/$defs/digest" } } },
    "checkpoint.accept": { "type": "object", "additionalProperties": false, "required": ["checkpoint_id"], "properties": { "checkpoint_id": { "$ref": "#/$defs/id" } } },
    "artifact.metadata": { "type": "object", "additionalProperties": false, "required": ["artifact_id"], "properties": { "artifact_id": { "$ref": "#/$defs/id" } } },
    "artifact.chunk": { "type": "object", "additionalProperties": false, "required": ["artifact_id", "offset", "length"], "properties": { "artifact_id": { "$ref": "#/$defs/id" }, "offset": { "type": "integer", "minimum": 0 }, "length": { "type": "integer", "minimum": 1, "maximum": 8388608 } } }
  },
  "x-owop-results": {
    "git.worktree.list": { "type": "object", "additionalProperties": false, "required": ["worktrees"], "properties": { "worktrees": { "type": "array", "items": { "$ref": "#/$defs/worktreeResource" } } } },
    "git.worktree.create": { "type": "object", "additionalProperties": false, "required": ["worktree"], "properties": { "worktree": { "$ref": "#/$defs/worktreeResource" } } },
    "git.worktree.describe": { "type": "object", "additionalProperties": false, "required": ["worktree"], "properties": { "worktree": { "$ref": "#/$defs/worktreeResource" } } },
    "git.worktree.merge": { "type": "object", "additionalProperties": false, "required": ["worktree"], "properties": { "worktree": { "$ref": "#/$defs/worktreeResource" } } },
    "git.worktree.archive": { "type": "object", "additionalProperties": false, "required": ["worktree"], "properties": { "worktree": { "$ref": "#/$defs/worktreeResource" } } },
    "git.worktree.remove": { "type": "object", "additionalProperties": false, "required": ["worktree"], "properties": { "worktree": { "$ref": "#/$defs/worktreeResource" } } },
    "git.worktree.prune": { "type": "object", "additionalProperties": false, "required": ["candidates", "pruned"], "properties": { "candidates": { "type": "array", "items": { "type": "string" } }, "pruned": { "type": "boolean" } } },
    "pty.list": { "type": "object", "additionalProperties": false, "required": ["terminals"], "properties": { "terminals": { "type": "array", "items": { "$ref": "#/$defs/terminalResource" } } } },
    "pty.describe": { "type": "object", "additionalProperties": false, "required": ["terminal"], "properties": { "terminal": { "$ref": "#/$defs/terminalResource" } } },
    "pty.create": { "type": "object", "additionalProperties": false, "required": ["terminal"], "properties": { "terminal": { "$ref": "#/$defs/terminalResource" } } },
    "pty.write": { "type": "object", "additionalProperties": false, "required": ["pty_id", "written"], "properties": { "pty_id": { "$ref": "#/$defs/id" }, "written": { "type": "integer", "minimum": 0 } } },
    "pty.resize": { "type": "object", "additionalProperties": false, "required": ["terminal"], "properties": { "terminal": { "$ref": "#/$defs/terminalResource" } } },
    "pty.attach": { "type": "object", "additionalProperties": false, "required": ["lease_id", "mode", "expires_at", "terminal", "snapshot_required", "events", "last_sequence"], "properties": { "lease_id": { "$ref": "#/$defs/id" }, "mode": { "enum": ["reader", "writer"] }, "expires_at": { "type": "number" }, "terminal": { "$ref": "#/$defs/terminalResource" }, "snapshot_required": { "type": "boolean" }, "snapshot": { "$ref": "#/$defs/terminalScreenSnapshot" }, "events": { "type": "array", "items": { "$ref": "#/$defs/terminalOutputEvent" } }, "last_sequence": { "type": "integer", "minimum": 0 } } },
    "pty.detach": { "type": "object", "additionalProperties": false, "required": ["terminal"], "properties": { "terminal": { "$ref": "#/$defs/terminalResource" } } },
    "pty.kill": { "type": "object", "additionalProperties": false, "required": ["terminal"], "properties": { "terminal": { "$ref": "#/$defs/terminalResource" } } }
  }
}
