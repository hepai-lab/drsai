{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendrsai.dev/schemas/agent-regression-suite-1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "cases"],
  "properties": {
    "schema_version": {"const": "opendrsai.agent-regression-suite/1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
    "title": {"type": "string"},
    "description": {"type": "string"},
    "cases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "defaults": {"type": "object"},
    "required_tags": {"type": "array", "items": {"type": "string"}}
  }
}
