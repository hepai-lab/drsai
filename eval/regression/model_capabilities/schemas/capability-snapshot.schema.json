{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opendrsai.model-capability-snapshot/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "agent_id", "created_at", "revisions", "results", "digest"],
  "properties": {
    "schema_version": {"const": "opendrsai.model-capability-snapshot/1"},
    "agent_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "created_at": {"type": "string", "format": "date-time"},
    "revisions": {"type": "object"},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "probe-result.schema.json"}
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
