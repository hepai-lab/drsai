#!/usr/bin/env bash
# drsai-tui — launcher for the DrSai TUI (Ink UI + Python gateway)
#
# Usage:
#   drsai-tui                  # Start TUI (spawn gateway + Ink UI)
#   drsai-tui --attach <url>   # Attach to existing gateway via WebSocket
#
# Environment variables:
#   DRSAI_TUI_ENABLE_WS=1      # Enable WebSocket attach mode in gateway
#   DRSAI_TUI_WS_PORT=<port>   # WebSocket port (default: 0 = ephemeral)
#   DRSAI_TUI_ATTACH_URL=<ws://...>  # Connect to this gateway (skip spawn)

set -euo pipefail

# Detect ui-tui directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
UI_TUI_DIR="$REPO_ROOT/ui-tui"

if [ ! -d "$UI_TUI_DIR" ]; then
  echo "Error: ui-tui directory not found at $UI_TUI_DIR"
  exit 1
fi

# Check for --attach flag
ATTACH_URL=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --attach)
      ATTACH_URL="$2"
      shift 2
      ;;
    --help)
      echo "Usage: drsai-tui [--attach <ws://url>]"
      echo ""
      echo "Start the DrSai TUI (Ink UI + Python gateway)."
      echo ""
      echo "Options:"
      echo "  --attach <url>   Attach to existing gateway via WebSocket"
      echo ""
      echo "Environment:"
      echo "  DRSAI_TUI_ENABLE_WS=1       Enable WebSocket server in gateway"
      echo "  DRSAI_TUI_WS_PORT=<port>    WebSocket port (default: 0)"
      echo "  DRSAI_TUI_ATTACH_URL=<url>  Attach to this gateway"
      exit 0
      ;;
    *)
      echo "Unknown option: $1"
      echo "Run 'drsai-tui --help' for usage"
      exit 1
      ;;
  esac
done

# If attach URL provided, export it for gatewayClient.ts
if [ -n "$ATTACH_URL" ]; then
  export DRSAI_TUI_ATTACH_URL="$ATTACH_URL"
fi

# Launch UI (which spawns gateway automatically unless ATTACH_URL is set)
cd "$UI_TUI_DIR"
exec pnpm dev
